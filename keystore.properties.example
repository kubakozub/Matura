# Skopiuj ten plik jako keystore.properties i uzupelnij wlasnymi wartosciami.
# keystore.properties NIE trafia do repozytorium - jest w .gitignore.
#
# Klucz tworzy sie raz:
#   keytool -genkeypair -v -keystore ~/klucze/nazwa.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias upload
#
# To jest klucz PRZESYLANIA (upload key). Aplikacja korzysta z podpisywania przez Google Play
# (Play App Signing), wiec zgubienie tego pliku albo hasla nie zamyka drogi do aktualizacji
# na zawsze: klucz przesylania da sie wymienic, zglaszajac to przez pomoc Konsoli Play.
# Do czasu wymiany nie da sie jednak wydac ZADNEJ poprawki, wiec dalej trzeba go pilnowac:
# zrob kopie zapasowa poza tym komputerem.

storeFile=/home/kali/klucze/nazwa.jks
storePassword=
keyAlias=upload
keyPassword=

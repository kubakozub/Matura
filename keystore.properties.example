# Skopiuj ten plik jako keystore.properties i uzupelnij wlasnymi wartosciami.
# keystore.properties NIE trafia do repozytorium - jest w .gitignore.
#
# Klucz tworzy sie raz:
#   keytool -genkeypair -v -keystore ~/klucze/nazwa.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias upload
#
# Zgubienie tego pliku albo hasla oznacza, ze nie da sie juz wydac aktualizacji
# tej aplikacji w Google Play. Zrob kopie zapasowa poza tym komputerem.

storeFile=/home/kali/klucze/nazwa.jks
storePassword=
keyAlias=upload
keyPassword=

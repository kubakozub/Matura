<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mikrofon sluzy WYLACZNIE do trybu glosowego w grze: wypowiedz jest
         zamieniana na tekst i porownywana ze slowami na planszy. Nagranie nie
         jest nigdzie zapisywane ani wysylane przez aplikacje. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Bez tego Android 11+ nie pokazuje aplikacji zadnej uslugi rozpoznawania mowy. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Okno systemowe rozpoznawania mowy to INNY intent niz usluga wiazana.
             Bez tego wpisu Android 11+ nie znajdzie aplikacji, ktora je obsluguje,
             i ostatni szczebel fallbacku bylby martwy. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Matura">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Matura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

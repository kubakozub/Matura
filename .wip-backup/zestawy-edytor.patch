+        val czesci = measurables.map { it.measure(constraints.copy(minHeight = 0)) }
+        val szerokosc = czesci.maxOfOrNull { it.width } ?: constraints.minWidth
+        val wysokosc = maxOf(czesci.maxOfOrNull { it.height } ?: 0, constraints.minHeight)
+        layout(szerokosc, wysokosc) {
+            czesci.forEach { it.place(0, (wysokosc - it.height) / 2) }
+        }
+    }

+/** Karta na gorze edytora: komunikat i przyciski pod nim, jeden pod drugim. */
+@Composable
+private fun KomunikatEdytora(
+    tekst: String,
+    ramka: Color,
+    dopisek: String? = null,
+    przyciski: @Composable () -> Unit,
+) {
+    Column(
+        Modifier
+            .fillMaxWidth()
+            .background(Palette.Surface)
+            .border(3.dp, ramka)
+            .padding(12.dp)
+    ) {
+        Text(
+            tekst,
+            color = Palette.Bone,
+            fontSize = 14.sp,
+            lineHeight = 19.sp,
+            // Karta pojawia sie sama, po dotknieciu czegos innego: czytnik ekranu ma ja oglosic.
+            modifier = Modifier.semantics { liveRegion = LiveRegionMode.Polite },
+        )
+        if (dopisek != null) {
+            Spacer(Modifier.height(4.dp))
+            Text(dopisek, color = Palette.Muted, fontSize = 12.sp, lineHeight = 17.sp)
+        }
+        Spacer(Modifier.height(10.dp))
+        przyciski()
+    }
+    Spacer(Modifier.height(12.dp))
+}
+
+@Composable
+private fun PasekCofania(str: Str, cofniecie: Cofniecie?, onCofnij: (Cofniecie) -> Unit) {
+    if (cofniecie == null) return
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .padding(vertical = 3.dp)
+            .background(Palette.Surface)
+            .border(2.dp, Palette.SurfaceHigh)
+            .padding(start = 12.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Text(
+            str.rowDeleted(cofniecie.numer),
+            color = Palette.Bone,
+            fontSize = 13.sp,
+            modifier = Modifier.weight(1f).semantics { liveRegion = LiveRegionMode.Polite },
+        )
+        GhostButton(str.undo) { onCofnij(cofniecie) }
+    }
+}
+
+@Composable
+private fun WierszPol(
+    str: Str,
+    numer: Int,
+    wiersz: WierszEdytora,
+    oznacz: Boolean,
+    onHaslo: (String) -> Unit,
+    onTlumaczenie: (String) -> Unit,
+    onUsun: () -> Unit,
+) {
+    // Oznaczamy dopiero po probie zapisu: w trakcie pisania kazdy wiersz jest przez chwile
+    // wypelniony w polowie i czerwona ramka przy kazdej literze tylko by przeszkadzala.
+    val brakHasla = oznacz && wiersz.haslo.isBlank() && wiersz.tlumaczenie.isNotBlank()
+    val brakTlumaczenia = oznacz && wiersz.tlumaczenie.isBlank() && wiersz.haslo.isNotBlank()
+    Column(
+        Modifier
+            .fillMaxWidth()
+            .padding(vertical = 3.dp)
+    ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text(
+                "$numer",
+                color = Palette.Muted,
+                fontSize = 11.sp,
+                modifier = Modifier.width(20.dp),
+            )
+            FieldInput(
+                wiersz.haslo, onHaslo, modifier = Modifier.weight(1f),
+                opis = str.termLabel(numer), blad = if (brakHasla) str.missingTerm else null,
+            )
+            Spacer(Modifier.width(6.dp))
+            FieldInput(
+                wiersz.tlumaczenie, onTlumaczenie, modifier = Modifier.weight(1f),
+                opis = str.definitionLabel(numer),
+                blad = if (brakTlumaczenia) str.missingDefinition else null,
+            )
+            Box(
+                Modifier
+                    .size(MIN_CEL_DOTYKU)
+                    .clickable(role = Role.Button) { onUsun() }
+                    .semantics { contentDescription = str.deleteRow(numer) },
+                contentAlignment = Alignment.Center,
+            ) {
+                PixelImage(pixel(R.drawable.cross), Modifier.size(15.dp))
             }
         }
+        if (brakHasla || brakTlumaczenia) {
+            // Napis obok czerwonej ramki: sam kolor nie mowi, czego brakuje, a czesc uczniow
+            // czerwieni od szarosci nie odroznia.
+            Text(
+                if (brakHasla) str.missingTerm else str.missingDefinition,
+                color = Palette.Danger,
+                fontSize = 12.sp,
+                modifier = Modifier.padding(start = 20.dp, top = 2.dp),
+            )
+        }
     }
 }
 

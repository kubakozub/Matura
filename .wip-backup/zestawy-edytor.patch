+package com.matura.app
+
+import com.matura.app.data.Repository
+import com.matura.app.data.SzkicZestawu
+import com.matura.app.data.SzkiceZestawow
+import com.matura.app.data.WierszSzkicu
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+/**
+ * Szkic edytora zestawow na dysku.
+ *
+ * Po co: stos ekranow zyje tylko w pamieci. Uczen w polowie wpisywania zestawu przechodzi do
+ * slownika, system ubija gre i po powrocie aplikacja stoi na ekranie startowym, a trzydziesci
+ * wpisanych wierszy nie istnieje nigdzie. Szkic ma to przezyc, wiec tutaj kazdy test konczy
+ * sie NOWYM obiektem nad tym samym katalogiem: tak wyglada restart procesu.
+ */
+class SzkiceZestawowTest {
+
+    /** Sklad dostaje katalog w konstruktorze, tak samo jak Repository w PersistenceTest. */
+    @get:Rule
+    val katalog = TemporaryFolder()
+
+    private fun plik(nazwa: String) = File(katalog.root, nazwa)
+
+    private fun poRestarcie() = SzkiceZestawow(katalog.root)
+
+    private val nowy = SzkicZestawu(
+        idZestawu = null,
+        tytul = "Czasowniki nieregularne",
+        jezykHasel = "English",
+        jezykTlumaczen = "Polski",
+        wiersze = listOf(
+            WierszSzkicu("go", "iść"),
+            WierszSzkicu("went", ""),
+            WierszSzkicu("", ""),
+        ),
+    )
+
+    private val poprawiany = SzkicZestawu(
+        idZestawu = "user-1",
+        tytul = "Moje słówka",
+        jezykHasel = "English",
+        jezykTlumaczen = "Polski",
+        wiersze = listOf(WierszSzkicu("dog", "pies, piesek", "u0123456789ab")),
+    )
+
+    @Test
+    fun `szkic przezywa restart razem z pustymi i niepelnymi wierszami`() {
+        assertTrue(SzkiceZestawow(katalog.root).zapisz(nowy))
+
+        assertEquals(nowy, poRestarcie().wczytaj(null))
+        assertTrue(plik(SzkiceZestawow.FILE_NAME).exists())
+        assertFalse("plik tymczasowy zostal po udanym zapisie", plik(SzkiceZestawow.TEMP_NAME).exists())
+    }
+
+    @Test
+    fun `wiersz szkicu pamieta identyfikator wpisu`() {
+        // Bez identyfikatora przywrocony szkic bylby dla zapisu lista NOWYCH slow i gubil nauke
+        // zestawu, ktory uczen tylko poprawial.
+        SzkiceZestawow(katalog.root).zapisz(poprawiany)
+
+        assertEquals("u0123456789ab", poRestarcie().wczytaj("user-1")!!.wiersze.single().id)
+    }
+
+    @Test
+    fun `bez szkicu nie ma czego wczytac i nie powstaje zaden plik`() {
+        val szkice = SzkiceZestawow(katalog.root)
+
+        assertNull(szkice.wczytaj(null))
+        assertNull(szkice.wczytaj("user-1"))
+        assertTrue(szkice.zestawyZeSzkicem().isEmpty())
+        assertTrue("kasowanie szkicu, ktorego nie ma, tez jest udane", szkice.usun(null))
+        assertFalse(plik(SzkiceZestawow.FILE_NAME).exists())
+    }
+
+    @Test
+    fun `szkic innego zestawu zostaje nietkniety`() {
+        // Niedokonczony NOWY zestaw czeka na przywrocenie, a uczen poprawia w tym czasie
+        // literowke w innym. Przy jednym szkicu na caly plik poprawka nadpisywalaby po cichu
+        // tamte wiersze.
+        val szkice = SzkiceZestawow(katalog.root)
+        szkice.zapisz(nowy)
+        szkice.zapisz(poprawiany)
+
+        val po = poRestarcie()
+        assertEquals(nowy, po.wczytaj(null))
+        assertEquals(poprawiany, po.wczytaj("user-1"))
+        assertEquals(setOf(null, "user-1"), po.zestawyZeSzkicem())
+    }
+
+    @Test
+    fun `nowsza wersja szkicu zastepuje starsza dla tego samego zestawu`() {
+        val szkice = SzkiceZestawow(katalog.root)
+        szkice.zapisz(nowy)
+        val dalej = nowy.copy(wiersze = nowy.wiersze + WierszSzkicu("see", "widzieć"))
+        szkice.zapisz(dalej)
+
+        assertEquals(dalej, poRestarcie().wczytaj(null))
+        assertEquals(setOf<String?>(null), poRestarcie().zestawyZeSzkicem())
+    }
+
+    @Test
+    fun `skasowanie szkicu zostawia pozostale, a ostatni zabiera plik`() {
+        val szkice = SzkiceZestawow(katalog.root)
+        szkice.zapisz(nowy)
+        szkice.zapisz(poprawiany)
+
+        assertTrue(szkice.usun(null))
+        assertNull(poRestarcie().wczytaj(null))
+        assertEquals(poprawiany, poRestarcie().wczytaj("user-1"))
+
+        assertTrue(szkice.usun("user-1"))
+        assertFalse("po ostatnim szkicu nie ma zostac pusty plik", plik(SzkiceZestawow.FILE_NAME).exists())
+    }
+
+    @Test
+    fun `nieczytelny plik szkicow jest pomijany i kasowany`() {
+        plik(SzkiceZestawow.FILE_NAME).writeText("""{"szkice":[{"tytul":"Urwany w pol""")
+
+        val szkice = SzkiceZestawow(katalog.root)
+        assertNull(szkice.wczytaj(null))
+        assertFalse(
+            "nieczytelny szkic wracalby przy kazdym otwarciu edytora",
+            plik(SzkiceZestawow.FILE_NAME).exists(),
+        )
+
+        // Po takim pliku sklad dziala dalej normalnie.
+        assertTrue(szkice.zapisz(nowy))
+        assertEquals(nowy, poRestarcie().wczytaj(null))
+    }
+
+    @Test
+    fun `nieudany zapis szkicu zostawia poprzedni szkic w calosci`() {
+        val szkice = SzkiceZestawow(katalog.root)
+        assertTrue(szkice.zapisz(nowy))
+
+        // Katalog podstawiony pod nazwe pliku tymczasowego: strumienia nie da sie otworzyc.
+        // Ta sama sztuczka co w PersistenceTest (prawa dostepu nie blokuja uzytkownika root).
+        val blokada = plik(SzkiceZestawow.TEMP_NAME)
+        blokada.mkdirs()
+        File(blokada, "zajete").writeText("x")
+
+        assertFalse(szkice.zapisz(nowy.copy(tytul = "Nowszy")))
+        assertEquals(
+            "zapis przez plik tymczasowy nie moze uszkodzic tego, co juz lezy na dysku",
+            nowy,
+            poRestarcie().wczytaj(null),
+        )
+    }
+
+    @Test
+    fun `szkic lezy obok zapisu gry i go nie dotyka`() {
+        val repo = Repository(katalog.root)
+        assertTrue(repo.setOptions(repo.load().options.copy(soundEnabled = false)))
+        val zapisPrzed = plik(Repository.FILE_NAME).readText()
+
+        assertTrue(repo.szkice.zapisz(nowy))
+
+        assertEquals(zapisPrzed, plik(Repository.FILE_NAME).readText())
+        assertEquals(nowy, SzkiceZestawow(katalog.root).wczytaj(null))
+        // I w druga strone: zapis gry nie rusza szkicu.
+        assertTrue(repo.setOptions(repo.load().options.copy(soundEnabled = true)))
+        assertEquals(nowy, SzkiceZestawow(katalog.root).wczytaj(null))
+    }
+
+    // ---- porownywanie tresci -------------------------------------------------
+
+    @Test
+    fun `tresc pomija puste wiersze, spacje na brzegach i identyfikatory`() {
+        val wpisany = SzkicZestawu(
+            idZestawu = "user-1",
+            tytul = "  Moje słówka ",
+            jezykHasel = "English",
+            jezykTlumaczen = "Polski ",
+            wiersze = listOf(
+                WierszSzkicu(" dog", "pies, piesek ", "u0123456789ab"),
+                WierszSzkicu("", "   "),
+            ),
+        )
+        val otwarty = poprawiany.copy(wiersze = listOf(WierszSzkicu("dog", "pies, piesek")))
+
+        assertEquals(otwarty.tresc(), wpisany.tresc())
+    }
+
+    @Test
+    fun `wiersz wypelniony w polowie jest trescia`() {
+        // To tez jest wpisana praca: edytor ma przy nim pytac przy wyjsciu i trzymac szkic.
+        val zPolowka = poprawiany.copy(wiersze = poprawiany.wiersze + WierszSzkicu("cat", ""))
+
+        assertNotEquals(poprawiany.tresc(), zPolowka.tresc())
+    }
+}
diff --git a/app/src/test/java/com/matura/app/ZestawyWRepozytoriumTest.kt b/app/src/test/java/com/matura/app/ZestawyWRepozytoriumTest.kt
new file mode 100644
index 0000000..fc250f7
--- /dev/null
+++ b/app/src/test/java/com/matura/app/ZestawyWRepozytoriumTest.kt
@@ -0,0 +1,351 @@
+package com.matura.app
+
+import com.matura.app.data.Repository
+import com.matura.app.data.SampleData
+import com.matura.app.learn.Attempt
+import com.matura.app.learn.EntryId
+import com.matura.app.learn.Outcome
+import com.matura.app.learn.Srs
+import com.matura.app.model.Direction
+import com.matura.app.model.Entry
+import com.matura.app.model.TaskKind
+import com.matura.app.model.WordProgress
+import com.matura.app.model.WordSet
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import kotlin.random.Random
+
+/**
+ * Dwie rzeczy, ktore zapis zestawu robi z POSTEPEM nauki.
+ *
+ * Zamiana kolumn. Klucz postepu to identyfikator wpisu i kierunek, a zamiana stron zostawia
+ * wierszowi identyfikator. Bez przestawienia zapisow slowo cwiczone tylko z angielskiego na
+ * polski bylo po zamianie "utrwalone" w kierunku, ktorego uczen nigdy nie probowal.
+ *
+ * Kopia zestawu z katalogu. Katalog jest tylko do odczytu; "Skopiuj do moich" robi z zestawu
+ * zestaw wlasny z nowymi identyfikatorami wpisow, a uczen nie ma przy tym zaczynac znanych slow
+ * od zera.
+ */
+class ZestawyWRepozytoriumTest {
+
+    @get:Rule
+    val katalog = TemporaryFolder()
+
+    private companion object {
+        const val DZIS = 19_875
+        const val WLASNY = "user-1"
+        fun poludnie(dzien: Int) = dzien * Srs.MS_PER_DAY + Srs.MS_PER_DAY / 2
+    }
+
+    private fun poRestarcie() = Repository(katalog.root)
+
+    private fun wlasny(repo: Repository) = repo.load().sets.first { it.id == WLASNY }
+
+    /** Jedna zaliczona proba: slowo laduje w pudelku 1 w podanym kierunku. */
+    private fun zalicz(repo: Repository, id: String, kierunek: Direction, znacznik: String) {
+        assertTrue(
+            repo.recordAttempt(
+                Attempt(id, kierunek, TaskKind.PRZYPOMNIENIE, Outcome.POPRAWNA, znacznik),
+                poludnie(DZIS),
+            ),
+        )
+    }
+
+    private fun zestawWlasny(repo: Repository, vararg wiersze: Pair<String, String>): List<Entry> {
+        assertTrue(
+            repo.upsertSet(
+                WordSet(id = WLASNY, title = "Moje słówka", entries = wiersze.map { Entry(it.first, it.second) }),
+            ),
+        )
+        return wlasny(repo).entries
+    }
+
+    /** Zapis tak, jak robi go edytor: wiersze niosa identyfikatory, z ktorymi zostaly otwarte. */
+    private fun zapiszZamienione(repo: Repository, wpisy: List<Entry>) = repo.upsertSet(
+        wlasny(repo).copy(
+            termLanguage = "Polski",
+            definitionLanguage = "English",
+            entries = wpisy.map { Entry(it.definition, it.term, it.id) },
+        ),
+    )
+
+    // ---- zamiana kolumn -------------------------------------------------------
+
+    @Test
+    fun `zamiana kolumn przenosi postep razem z umiejetnoscia`() {
+        val repo = Repository(katalog.root)
+        val (dog, cat) = zestawWlasny(repo, "dog" to "pies", "cat" to "kot")
+        // "dog" cwiczony z angielskiego na polski, "cat" w obie strony, ale kazda inaczej.
+        zalicz(repo, dog.id, Direction.TERM_TO_DEF, "p1")
+        zalicz(repo, cat.id, Direction.TERM_TO_DEF, "p2")
+        assertTrue(
+            repo.recordAttempt(
+                Attempt(cat.id, Direction.DEF_TO_TERM, TaskKind.PRZYPOMNIENIE, Outcome.BLEDNA, "p3"),
+                poludnie(DZIS),
+            ),
+        )
+        val przed = repo.load().progress
+        val catAngPol = przed.getValue(Srs.key(cat.id, Direction.TERM_TO_DEF))
+        val catPolAng = przed.getValue(Srs.key(cat.id, Direction.DEF_TO_TERM))
+        assertNotEquals(catAngPol, catPolAng)
+
+        assertTrue(zapiszZamienione(repo, listOf(dog, cat)))
+
+        val po = poRestarcie()
+        val wpisy = po.load().sets.first { it.id == WLASNY }.entries
+        assertEquals("wiersze zachowuja tozsamosc", listOf(dog.id, cat.id), wpisy.map { it.id })
+        assertEquals(listOf("pies", "kot"), wpisy.map { it.term })
+
+        // Teraz TERM_TO_DEF znaczy "pies -> dog", czyli kierunek, ktorego uczen nie cwiczyl.
+        assertEquals(Srs.NO_BOX, po.progressOf(dog.id, Direction.TERM_TO_DEF).box)
+        assertFalse(
+            "pusty stan ma byc brakiem wpisu, a nie wpisem z pudelkiem 0",
+            po.load().progress.containsKey(Srs.key(dog.id, Direction.TERM_TO_DEF)),
+        )
+        assertEquals(Srs.FIRST_BOX, po.progressOf(dog.id, Direction.DEF_TO_TERM).box)
+        // Dwa rozne zapisy zamieniaja sie miejscami w calosci, z licznikami i terminem.
+        assertEquals(catPolAng, po.progressOf(cat.id, Direction.TERM_TO_DEF))
+        assertEquals(catAngPol, po.progressOf(cat.id, Direction.DEF_TO_TERM))
+    }
+
+    @Test
+    fun `dwie zamiany z rzedu wracaja do punktu wyjscia`() {
+        val repo = Repository(katalog.root)
+        val (dog) = zestawWlasny(repo, "dog" to "pies")
+        zalicz(repo, dog.id, Direction.TERM_TO_DEF, "p1")
+        val przed = repo.load().progress
+
+        assertTrue(zapiszZamienione(repo, listOf(dog)))
+        assertTrue(zapiszZamienione(repo, wlasny(repo).entries))
+
+        assertEquals(przed, poRestarcie().load().progress)
+        assertEquals("dog", wlasny(repo).entries.single().term)
+    }
+
+    @Test
+    fun `zamiana dziala takze wtedy, gdy wiersze przychodza bez identyfikatorow`() {
+        // Tak zapisuja zestaw wolajacy, ktorzy nie niosa identyfikatorow: tozsamosc wiersza
+        // odtwarza wtedy EntryId.reconcile po numerze wiersza i regula ma dzialac tak samo.
+        val repo = Repository(katalog.root)
+        val (dog) = zestawWlasny(repo, "dog" to "pies")
+        zalicz(repo, dog.id, Direction.TERM_TO_DEF, "p1")
+
+        assertTrue(repo.upsertSet(wlasny(repo).copy(entries = listOf(Entry("pies", "dog")))))
+
+        val po = poRestarcie()
+        assertEquals(dog.id, po.load().sets.first { it.id == WLASNY }.entries.single().id)
+        assertEquals(Srs.NO_BOX, po.progressOf(dog.id, Direction.TERM_TO_DEF).box)
+        assertEquals(Srs.FIRST_BOX, po.progressOf(dog.id, Direction.DEF_TO_TERM).box)
+    }
+
+    @Test
+    fun `zwykla poprawka i zapis bez zmian nie ruszaja postepu`() {
+        val repo = Repository(katalog.root)
+        val (dog, cat, radar) = zestawWlasny(repo, "dog" to "pies", "cat" to "kot", "radar" to "radar")
+        listOf(dog, cat, radar).forEachIndexed { i, wpis ->
+            zalicz(repo, wpis.id, Direction.TERM_TO_DEF, "p$i")
+        }
+        val przed = repo.load().progress
+
+        // Bez zmian, potem poprawka tlumaczenia. Wiersz o dwoch jednakowych stronach jest
+        // swoim wlasnym odbiciem i nie moze przy kazdym zapisie przeskakiwac miedzy kierunkami.
+        assertTrue(repo.upsertSet(wlasny(repo)))
+        assertEquals(przed, repo.load().progress)
+        assertTrue(
+            repo.upsertSet(
+                wlasny(repo).copy(
+                    entries = listOf(dog, cat.copy(definition = "kot, kotka"), radar),
+                ),
+            ),
+        )
+
+        assertEquals(przed, poRestarcie().load().progress)
+    }
+
+    @Test
+    fun `wiersz poprawiony przy okazji zamiany zostaje przy swoim postepie`() {
+        // Po tresci nie da sie go odroznic od zwyklej poprawki, wiec regula go nie rusza.
+        val repo = Repository(katalog.root)
+        val (dog, cat) = zestawWlasny(repo, "dog" to "pies", "cat" to "kot")
+        zalicz(repo, dog.id, Direction.TERM_TO_DEF, "p1")
+        zalicz(repo, cat.id, Direction.TERM_TO_DEF, "p2")
+
+        assertTrue(
+            repo.upsertSet(
+                wlasny(repo).copy(
+                    entries = listOf(Entry("pies", "dog", dog.id), Entry("kotek", "cat", cat.id)),
+                ),
+            ),
+        )
+
+        val po = poRestarcie()
+        assertEquals(Srs.FIRST_BOX, po.progressOf(dog.id, Direction.DEF_TO_TERM).box)
+        assertEquals(Srs.FIRST_BOX, po.progressOf(cat.id, Direction.TERM_TO_DEF).box)
+        assertEquals(Srs.NO_BOX, po.progressOf(cat.id, Direction.DEF_TO_TERM).box)
+    }
+
+    @Test
+    fun `nieudany zapis zamiany nie zostawia postepu w polowie`() {
+        val repo = Repository(katalog.root)
+        val (dog) = zestawWlasny(repo, "dog" to "pies")
+        zalicz(repo, dog.id, Direction.TERM_TO_DEF, "p1")
+        val przed = repo.load()
+
+        val blokada = File(katalog.root, Repository.TEMP_NAME)
+        blokada.mkdirs()
+        File(blokada, "zajete").writeText("x")
+
+        assertFalse(zapiszZamienione(repo, listOf(dog)))
+        assertEquals("pamiec nie moze twierdzic czegos, czego nie ma na dysku", przed, repo.load())
+        blokada.deleteRecursively()
+        assertEquals(przed, poRestarcie().load())
+    }
+
+    // ---- kopia zestawu z katalogu ---------------------------------------------
+
+    private val oryginal = SampleData.builtInSets().first()
+
+    /** Kopia tak, jak sklada ja edytor: zestaw wlasny, wpisy z identyfikatorami katalogu. */
+    private fun kopia(wpisy: List<Entry> = oryginal.entries) = WordSet(
+        id = "user-kopia",
+        title = oryginal.title.replace('·', '-') + " kopia",
+        termLanguage = oryginal.termLanguage,
+        definitionLanguage = oryginal.definitionLanguage,
+        entries = wpisy,
+        builtIn = false,
+        createdAt = 1_700_000_000_000L,
+    )
+
+    @Test
+    fun `kopia dostaje wlasne identyfikatory i postep w obu kierunkach`() {
+        val repo = Repository(katalog.root)
+        val (pierwsze, drugie, trzecie) = oryginal.entries
+        zalicz(repo, pierwsze.id, Direction.TERM_TO_DEF, "p1")
+        zalicz(repo, pierwsze.id, Direction.DEF_TO_TERM, "p2")
+        zalicz(repo, drugie.id, Direction.DEF_TO_TERM, "p3")
+        val przed = repo.load().progress
+
+        assertTrue(repo.zapiszKopieZestawu(kopia(), Random(7)))
+
+        val po = poRestarcie()
+        val zapisana = po.load().sets.last()
+        assertEquals("user-kopia", zapisana.id)
+        assertFalse(zapisana.builtIn)
+        assertEquals(
+            oryginal.entries.map { it.term to it.definition },
+            zapisana.entries.map { it.term to it.definition },
+        )
+        assertTrue("kazdy wpis kopii ma identyfikator wlasny", zapisana.entries.all { EntryId.isUser(it.id) })
+        assertEquals(
+            "identyfikatory kopii sa rozne",
+            zapisana.entries.size,
+            zapisana.entries.map { it.id }.toSet().size,
+        )
+
+        fun katalogowy(wpis: Entry, kierunek: Direction) = przed.getValue(Srs.key(wpis.id, kierunek))
+        val (k1, k2, k3) = zapisana.entries
+        assertEquals(katalogowy(pierwsze, Direction.TERM_TO_DEF), po.progressOf(k1.id, Direction.TERM_TO_DEF))
+        assertEquals(katalogowy(pierwsze, Direction.DEF_TO_TERM), po.progressOf(k1.id, Direction.DEF_TO_TERM))
+        // Kierunek, ktorego uczen nie cwiczyl w katalogu, w kopii tez jest pusty.
+        assertEquals(WordProgress(), po.progressOf(k2.id, Direction.TERM_TO_DEF))
+        assertEquals(katalogowy(drugie, Direction.DEF_TO_TERM), po.progressOf(k2.id, Direction.DEF_TO_TERM))
+        assertEquals(trzecie.term, k3.term)
+        assertEquals("slowo bez historii zostaje bez historii", WordProgress(), po.progressOf(k3.id, Direction.TERM_TO_DEF))
+    }
+
+    @Test
+    fun `postep slowa z katalogu i sam katalog zostaja nietkniete`() {
+        val repo = Repository(katalog.root)
+        val pierwsze = oryginal.entries.first()
+        zalicz(repo, pierwsze.id, Direction.TERM_TO_DEF, "p1")
+        val przed = repo.load()
+
+        assertTrue(repo.zapiszKopieZestawu(kopia(), Random(7)))
+
+        val po = poRestarcie().load()
+        assertEquals("katalog w zapisie ma zostac co do znaku ten sam", przed.sets, po.sets.dropLast(1))
+        for ((klucz, stan) in przed.progress) {
+            assertEquals("postep sprzed kopii zmienil sie pod kluczem $klucz", stan, po.progress[klucz])
+        }
+        // Dalsza nauka kopii nie wraca do katalogu: od zapisu to dwa osobne slowa.
+        val wKopii = po.sets.last().entries.first()
+        val repo2 = poRestarcie()
+        assertTrue(
+            repo2.recordAttempt(
+                Attempt(wKopii.id, Direction.TERM_TO_DEF, TaskKind.PRZYPOMNIENIE, Outcome.BLEDNA, "p9"),
+                poludnie(DZIS + 1),
+            ),
+        )
+        assertEquals(
+            przed.progress.getValue(Srs.key(pierwsze.id, Direction.TERM_TO_DEF)),
+            repo2.progressOf(pierwsze.id, Direction.TERM_TO_DEF),
+        )
+    }
+
+    @Test
+    fun `wiersz dopisany w kopii jest nowym slowem, a skasowany nie zostawia sladu`() {
+        val repo = Repository(katalog.root)
+        val (pierwsze, drugie) = oryginal.entries
+        zalicz(repo, pierwsze.id, Direction.TERM_TO_DEF, "p1")
+        zalicz(repo, drugie.id, Direction.TERM_TO_DEF, "p2")
+        val ilePrzed = repo.load().progress.size
+
+        // Uczen skasowal w kopii pierwszy wiersz i dopisal wlasny.
+        assertTrue(repo.zapiszKopieZestawu(kopia(listOf(drugie, Entry("ripe", "dojrzały"))), Random(7)))
+
+        val po = poRestarcie()
+        val (k2, dopisany) = po.load().sets.last().entries
+        assertEquals(Srs.FIRST_BOX, po.progressOf(k2.id, Direction.TERM_TO_DEF).box)
+        assertTrue(EntryId.isUser(dopisany.id))
+        assertEquals(WordProgress(), po.progressOf(dopisany.id, Direction.TERM_TO_DEF))
+        assertEquals(
+            "doszedl dokladnie jeden zapis postepu: dla wiersza, ktory zostal w kopii",
+            ilePrzed + 1,
+            po.load().progress.size,
+        )
+    }
+
+    @Test
+    fun `nieudany zapis kopii nie zostawia ani zestawu, ani postepu`() {
+        val repo = Repository(katalog.root)
+        zalicz(repo, oryginal.entries.first().id, Direction.TERM_TO_DEF, "p1")
+        val przed = repo.load()
+
+        val blokada = File(katalog.root, Repository.TEMP_NAME)
+        blokada.mkdirs()
+        File(blokada, "zajete").writeText("x")
+
+        assertFalse(repo.zapiszKopieZestawu(kopia(), Random(7)))
+        assertEquals(przed, repo.load())
+        blokada.deleteRecursively()
+        assertEquals(przed, poRestarcie().load())
+    }
+
+    @Test
+    fun `zapisana kopia jest zwyklym zestawem wlasnym`() {
+        val repo = Repository(katalog.root)
+        val pierwsze = oryginal.entries.first()
+        zalicz(repo, pierwsze.id, Direction.TERM_TO_DEF, "p1")
+        assertTrue(repo.zapiszKopieZestawu(kopia(), Random(7)))
+        val zapisana = repo.load().sets.last()
+
+        // Drugi zapis idzie juz przez upsertSet: identyfikatory i postep zostaja.
+        assertTrue(repo.upsertSet(zapisana.copy(title = "Charakter po mojemu")))
+
+        val po = poRestarcie()
+        val poDrugim = po.load().sets.last()
+        assertEquals("Charakter po mojemu", poDrugim.title)
+        assertEquals(zapisana.entries, poDrugim.entries)
+        assertEquals(Srs.FIRST_BOX, po.progressOf(poDrugim.entries.first().id, Direction.TERM_TO_DEF).box)
+        // I da sie ja skasowac, w odroznieniu od zestawu z katalogu.
+        assertTrue(po.deleteSet(poDrugim.id))
+        assertTrue(po.load().sets.none { it.id == poDrugim.id })
+        assertTrue(po.load().sets.any { it.id == oryginal.id })
+    }
+}
diff --git a/app/src/testDebug/java/com/matura/app/A11yLiveRegionProbeTest.kt b/app/src/testDebug/java/com/matura/app/A11yLiveRegionProbeTest.kt
index 1326496..8ec8162 100644
--- a/app/src/testDebug/java/com/matura/app/A11yLiveRegionProbeTest.kt
+++ b/app/src/testDebug/java/com/matura/app/A11yLiveRegionProbeTest.kt
@@ -33,17 +33,16 @@ class A11yLiveRegionProbeTest {
 
     private companion object {

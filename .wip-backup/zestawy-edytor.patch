@@ -0,0 +1,181 @@
+package com.matura.app
+
+import com.matura.app.data.BuiltInSets
+import com.matura.app.model.Achievement
+import com.matura.app.model.UiLanguage
+import com.matura.app.ui.PixelFont
+import com.matura.app.ui.SesjaStr
+import com.matura.app.ui.Str
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.lang.reflect.Modifier
+
+/**
+ * Font bitmapowy ma 93 glify, a uczen wpisuje imie i wlasne zestawy czym chce.
+ *
+ * Do 0.9.18 znak spoza arkusza rysowal sie jako pusta kratka: imie "Zoë" stalo pod logo jako
+ * "Zo ", "Олена" jako pusta linia, a zestaw "Straße" szedl na plansze jako "Stra e". Czytnik
+ * ekranu dostawal przy tym pelny napis, wiec widzacy i niewidomy uczen mieli co innego.
+ *
+ * Dwie strony tej samej poprawki sa tu sprawdzane osobno. Znak z akcentem albo ligatura ma sie
+ * narysowac literami arkusza. A wszystko, co aplikacja rysuje SAMA (napisy interfejsu, katalog
+ * slow), ma wygladac dokladnie tak jak przedtem: zadnego przepisywania i zadnego zejscia na
+ * czcionke systemu.
+ */
+class PixelFontZnakiTest {
+
+    // ---- znaki wpisane przez ucznia -------------------------------------------
+
+    @Test
+    fun `litera z akcentem rysuje sie jako litera podstawowa`() {
+        assertEquals("Zoe", PixelFont.rozpisz("Zoë"))
+        assertEquals("Cafe deja vu", PixelFont.rozpisz("Café déjà vu"))
+        assertEquals("Nino Muller Zizka", PixelFont.rozpisz("Niño Müller Žižka"))
+        assertEquals("ANGSTROM", PixelFont.rozpisz("ÅNGSTRÖM"))
+        assertTrue(PixelFont.daSieNarysowac("Zoë"))
+        assertTrue(PixelFont.daSieNarysowac("Café déjà vu"))
+    }
+
+    @Test
+    fun `akcent wpisany osobnym znakiem odpada, a litera zostaje`() {
+        // Ta sama litera w postaci rozlozonej: "e" i osobny znak akcentu (U+0308, U+0301).
+        assertEquals("Zoe", PixelFont.rozpisz("Zoë"))
+        assertEquals("Cafe", PixelFont.rozpisz("Café"))
+        assertTrue(PixelFont.daSieNarysowac("Zoë"))
+    }
+
+    @Test
+    fun `polskie litery zostaja polskimi literami`() {
+        // Arkusz MA polskie znaki. Rozklad na litere i akcent zrobilby z "ż" zwykle "z".
+        val polskie = "Zażółć gęślą jaźń ZAŻÓŁĆ GĘŚLĄ JAŹŃ"
+        assertSame(polskie, PixelFont.rozpisz(polskie))
+    }
+
+    @Test
+    fun `niemieckie ostre s i ligatury rozpisuja sie na dwie litery`() {
+        assertEquals("Strasse", PixelFont.rozpisz("Straße"))
+        assertEquals("STRASSE", PixelFont.rozpisz("STRAẞE"))
+        assertEquals("fish, flower, office", PixelFont.rozpisz("ﬁsh, ﬂower, oﬃce"))
+        assertEquals("aether oeuvre AEON", PixelFont.rozpisz("æther œuvre ÆON"))
+        assertEquals("smorrebrod", PixelFont.rozpisz("smørrebrød"))
+        assertTrue(PixelFont.daSieNarysowac("Straße"))
+    }
+
+    @Test
+    fun `cudzyslowy, kreski i spacje o innych kodach maja zwykle odpowiedniki`() {
+        assertEquals("'bonjour' 'hola'", PixelFont.rozpisz("«bonjour» ‹hola›"))
+        assertEquals("5 - 3", PixelFont.rozpisz("5 − 3"))
+        assertEquals("?Que? !Si!", PixelFont.rozpisz("¿Que? ¡Si!"))
+        assertEquals("10 km", PixelFont.rozpisz("10 km"))
+    }
+
+    @Test
+    fun `znak bez glifu zostaje w napisie i kieruje caly napis do czcionki systemu`() {
+        for (napis in listOf("Олена", "Ελένη", "李明", "Kuba 🙂", "Zoë Олена")) {
+            assertFalse("\"$napis\" nie ma kompletu glifow", PixelFont.daSieNarysowac(napis))
+        }
+        // Niczego nie gubimy po drodze: czego nie da sie przepisac, zostaje, jak bylo.
+        assertEquals("Олена", PixelFont.rozpisz("Олена"))
+        assertEquals("Zoe Олена", PixelFont.rozpisz("Zoë Олена"))
+    }
+
+    @Test
+    fun `pusty napis i zlamanie linii nie sa bledem`() {
+        assertSame("", PixelFont.rozpisz(""))
+        assertTrue(PixelFont.daSieNarysowac(""))
+        assertTrue(PixelFont.daSieNarysowac("dwie\nlinie"))
+        assertEquals("dwie\nlinie", PixelFont.rozpisz("dwie\nlinie"))
+    }
+
+    // ---- to, co aplikacja rysuje sama -----------------------------------------
+
+    /**
+     * Wszystkie teksty jednej tablicy napisow, w obu jezykach: wlasciwosci i funkcje publiczne
+     * zwracajace String. Funkcje dostaja po kilka wartosci kazdego parametru, bo odmiana zalezy
+     * od liczby, a nazwa kroku sesji od jego rodzaju.
+     */
+    private fun napisyZ(tablica: (UiLanguage) -> Any): Map<String, List<String>> {
+        val wynik = LinkedHashMap<String, MutableList<String>>()
+        for (jezyk in UiLanguage.entries) {
+            val obiekt = tablica(jezyk)
+            for (metoda in obiekt.javaClass.declaredMethods) {
+                if (!Modifier.isPublic(metoda.modifiers) || metoda.returnType != String::class.java) continue
+                val wartosci = metoda.parameterTypes.map { typ ->
+                    when {
+                        typ == Int::class.javaPrimitiveType -> listOf(1, 2, 5, 22)
+                        typ == String::class.java -> listOf("Moje")
+                        typ == List::class.java -> listOf(listOf(4), listOf(2, 5), listOf(2, 5, 6, 7, 9))
+                        typ.isEnum -> typ.enumConstants.toList()
+                        else -> error("nieznany typ parametru ${typ.name} w ${metoda.name}")
+                    }
+                }
+                val ile = wartosci.maxOfOrNull { it.size } ?: 1
+                for (nr in 0 until ile) {
+                    val argumenty = wartosci.map { it[nr % it.size] }
+                    val napis = metoda.invoke(obiekt, *argumenty.toTypedArray()) as String
+                    wynik.getOrPut(metoda.name) { ArrayList() }.add(napis)
+                }
+            }
+        }
+        return wynik
+    }
+
+    /**
+     * Teksty z Str, ktore maja w sobie strzalke. Arkusz jej nie ma i nie ma jej czym zastapic,
+     * wiec te napisy ida ZAWSZE czcionka systemu (Text): chipy kierunku, podpowiedzi "OPCJE →"
+     * i polityka prywatnosci. Lista jest jawna, zeby nowy napis ze znakiem spoza arkusza nie
+     * przeszedl niezauwazony: albo trafi tutaj swiadomie, albo test go zatrzyma.
+     */
+    private val pisaneCzcionkaSystemu = setOf(
+        "getDirTermToDef", "getDirDefToTerm", "getVoiceTestWhere", "getRawMicWhere", "getPrivacyBody",
+    )
+
+    @Test
+    fun `zaden napis interfejsu nie schodzi na czcionke systemu`() {
+        val napisy = napisyZ { Str(it) } + napisyZ { SesjaStr(it) }.mapKeys { "sesja." + it.key }
+        assertTrue("refleksja nie znalazla napisow: ${napisy.size}", napisy.size > 150)
+
+        val schodzace = napisy
+            .filterKeys { it !in pisaneCzcionkaSystemu }
+            .filterValues { wersje -> wersje.any { !PixelFont.daSieNarysowac(it) } }
+            .keys
+        assertEquals(
+            "napisy, ktorych font bitmapowy nie narysuje w calosci (PixelText pokaze je czcionka systemu)",
+            emptySet<String>(),
+            schodzace,
+        )
+
+        // Lista wyjatkow nie moze zarosnac: napis, ktory juz sie miesci, ma z niej zniknac.
+        for (nazwa in pisaneCzcionkaSystemu) {
+            assertTrue(
+                "$nazwa miesci sie w arkuszu, wiec nie powinien byc na liscie wyjatkow",
+                napisy.getValue(nazwa).any { !PixelFont.daSieNarysowac(it) },
+            )
+        }
+    }
+
+    @Test
+    fun `napisy interfejsu i katalog slow rysuja sie tak jak przedtem`() {
+        // "Tak jak przedtem" znaczy tu: napis nie jest przepisywany, wiec do rysowania idzie
+        // znak w znak to samo co do 0.9.18. Ten sam obiekt wraca tylko wtedy, gdy kazdy znak
+        // jest w arkuszu albo ma w nim dawny zamiennik.
+        val katalog = BuiltInSets.all()
+        val slowa = katalog.flatMap { set ->
+            listOf(set.title, set.shortTitle, set.category.orEmpty()) +
+                set.entries.flatMap { listOf(it.term, it.definition) }
+        }
+        assertTrue("katalog jest pusty?", slowa.size > 4000)
+        val odznaki = Achievement.entries.flatMap { listOf(it.titlePl, it.titleEn, it.descPl, it.descEn) }
+        val interfejs = (napisyZ { Str(it) } + napisyZ { SesjaStr(it) }.mapKeys { "sesja." + it.key })
+            .filterKeys { it !in pisaneCzcionkaSystemu }
+            .values.flatten()
+
+        for (napis in slowa + odznaki + interfejs + BuiltInSets.randomMix(seed = 1).title) {
+            assertTrue("\"$napis\" zszedlby na czcionke systemu", PixelFont.daSieNarysowac(napis))
+            assertSame("\"$napis\" jest przepisywany przed rysowaniem", napis, PixelFont.rozpisz(napis))
+        }
+    }
+}

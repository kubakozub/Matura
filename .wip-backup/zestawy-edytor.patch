+/**
+ * Jeden wiersz edytora. [klucz] rozroznia wiersze na ekranie (pole trzyma kursor przy SWOIM
+ * wierszu, kiedy sasiedni znika), a [id] to identyfikator wpisu, z ktorego wiersz powstal:
+ * dzieki niemu zapis wie, ze poprawiony wiersz to dalej to samo slowo, a wiersz dopisany w
+ * miejsce skasowanego juz nie.
+ */
+private data class WierszEdytora(
+    val klucz: Int,
+    val haslo: String,
+    val tlumaczenie: String,
+    val id: String = "",
+)
+
+private val WierszEdytora.pusty get() = haslo.isBlank() && tlumaczenie.isBlank()
+private val WierszEdytora.pelny get() = haslo.isNotBlank() && tlumaczenie.isNotBlank()
+
+/** Wszystko, co uczen wpisal w edytorze. Osobna klasa, zeby szkic dalo sie wczytac jednym ruchem. */
+private class StanEdytora(poczatek: SzkicZestawu) {
+    var tytul by mutableStateOf("")
+    var jezykHasel by mutableStateOf("")
+    var jezykTlumaczen by mutableStateOf("")
+    val wiersze = mutableStateListOf<WierszEdytora>()
+    private var nastepnyKlucz = 0
+
+    init {
+        wczytaj(poczatek)
+    }
+
+    fun nowyWiersz(haslo: String = "", tlumaczenie: String = "", id: String = "") =
+        WierszEdytora(nastepnyKlucz++, haslo, tlumaczenie, id)
+
+    fun wczytaj(szkic: SzkicZestawu) {
+        tytul = szkic.tytul
+        jezykHasel = szkic.jezykHasel
+        jezykTlumaczen = szkic.jezykTlumaczen
+        wiersze.clear()
+        wiersze.addAll(szkic.wiersze.map { nowyWiersz(it.haslo, it.tlumaczenie, it.id) })
+        if (wiersze.isEmpty()) wiersze.add(nowyWiersz())
+    }
+
+    fun szkic(idZestawu: String?) = SzkicZestawu(
+        idZestawu = idZestawu,
+        tytul = tytul,
+        jezykHasel = jezykHasel,
+        jezykTlumaczen = jezykTlumaczen,
+        wiersze = wiersze.map { WierszSzkicu(it.haslo, it.tlumaczenie, it.id) },
+    )
+}

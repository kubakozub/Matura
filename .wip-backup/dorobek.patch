@@ -0,0 +1,139 @@
+package com.matura.app
+
+import com.matura.app.data.BuiltInSets
+import com.matura.app.data.Repository
+import com.matura.app.learn.Attempt
+import com.matura.app.learn.Nagrody
+import com.matura.app.learn.Outcome
+import com.matura.app.learn.Srs
+import com.matura.app.learn.Wplyw
+import com.matura.app.model.Direction
+import com.matura.app.model.Entry
+import com.matura.app.model.GameMode
+import com.matura.app.model.Options
+import com.matura.app.model.ScoreRecord
+import com.matura.app.model.TaskKind
+import com.matura.app.model.WordSet
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+class ZzSonda2Test {
+
+    @get:Rule
+    val katalog = TemporaryFolder()
+
+    private val out = File("/tmp/claude-0/-home-user-Matura/0e5748ef-99b0-59e1-b03e-46ac0f545d18/scratchpad/sonda-out.txt")
+    private fun log(s: String) = out.appendText(s + "\n")
+    private fun ms(dzien: Int, godz: Int = 12, min: Int = 0) = dzien.toLong() * Srs.MS_PER_DAY + godz * 3_600_000L + min * 60_000L
+    private var nr = 0
+    private fun typed(id: String, outcome: Outcome = Outcome.POPRAWNA, dir: Direction = Direction.TERM_TO_DEF, task: TaskKind = TaskKind.PRZYPOMNIENIE) =
+        Attempt(id, dir, task, outcome, "s${nr++}")
+
+    private val slowa = BuiltInSets.all().flatMap { it.entries }.map { it.id }.distinct()
+
+    @Test
+    fun `S1 runda przez polnoc`() {
+        log("=== S1 round across UTC midnight: goal met at 23:5x, one more word at 00:0x")
+        val repo = Repository(katalog.root)
+        val d = 20_000
+        val przed = repo.load()
+        val wplywy = ArrayList<Wplyw>()
+        for (i in 0 until 3) repo.recordAttempt(typed(slowa[i]), ms(d, 23, 50 + i), naWplyw = { wplywy += it })
+        repo.recordAttempt(typed(slowa[3]), ms(d + 1, 0, 2), naWplyw = { wplywy += it })
+        val wynik = ScoreRecord("x", "y", 100, 1, 1, 4, ms(d + 1, 0, 3), GameMode.CLASSIC)
+        repo.recordGame(wynik, "brak", nowMs = ms(d + 1, 0, 3), potwierdzOdznaki = true)
+        val po = repo.load()
+        val n = Nagrody.roznica(przed, po, wplywy, wynik, Srs.dayOf(ms(d + 1, 0, 3)))
+        log("ledger: dniNauki=${po.dorobek.dniNauki} seria=${po.dorobek.seria} seriaDzien-d=${po.dorobek.seriaDzien - d}")
+        log("roznica: xp=${n.xp} xpDzisPo=${n.xpDzisPo} celZaliczonyTeraz=${n.celZaliczonyTeraz} celZaliczony=${n.celZaliczony} pierwszyDzien=${n.pierwszyDzien} seriaPo=${n.seriaPo} dniNauki=${n.dniNauki}")
+    }
+
+    @Test
+    fun `S2 podpowiedz codziennie`() {
+        log("=== S2 hint (PODPOWIEDZ) on a consolidated word every day")
+        val repo = Repository(katalog.root)
+        val d0 = 20_000
+        val id = slowa[0]
+        repo.recordAttempt(typed(id), ms(d0)); repo.recordAttempt(typed(id), ms(d0 + 1)); repo.recordAttempt(typed(id), ms(d0 + 4))
+        val baza = repo.load().dorobek.xp
+        repo.recordAttempt(typed(id, Outcome.PODPOWIEDZ), ms(d0 + 4))
+        for (dz in d0 + 5..d0 + 14) {
+            repo.recordAttempt(typed(id), ms(dz))
+            repo.recordAttempt(typed(id, Outcome.PODPOWIEDZ), ms(dz))
+        }
+        val k = repo.load()
+        log("10 days: xp +${k.dorobek.xp - baza}, box=${Srs.progressOf(k.progress, id, Direction.TERM_TO_DEF).box}, powtorki=${k.dorobek.powtorki}")
+    }
+
+    @Test
+    fun `S3 wlasny zestaw codziennie od nowa`() {
+        log("=== S3 own set of 10 trivial rows, deleted and recreated every day")
+        val repo = Repository(katalog.root)
+        repo.load()
+        val d0 = 20_000
+        for (dz in d0 until d0 + 30) {
+            repo.deleteSet("user-1")
+            repo.upsertSet(WordSet(id = "user-1", title = "x", entries = (0 until 10).map { Entry("a$it", "a$it") }))
+            for (e in repo.load().sets.first { it.id == "user-1" }.entries) repo.recordAttempt(typed(e.id), ms(dz))
+        }
+        val k = repo.load().dorobek
+        log("30 days: xp=${k.xp} etap=${Nagrody.etap(k.xp)} dniNauki=${k.dniNauki} rekordSerii=${k.rekordSerii} powtorki=${k.powtorki} odznaki=${k.odznaki.keys}")
+    }
+
+    @Test
+    fun `S4 trzy nowe slowa dziennie bez powtorek`() {
+        log("=== S4 three new catalogue words a day, never a review")
+        val repo = Repository(katalog.root)
+        val d0 = 20_000
+        var i = 0
+        for (dz in d0 until d0 + 30) repeat(3) { repo.recordAttempt(typed(slowa[i++]), ms(dz)) }
+        val k = repo.load().dorobek
+        log("30 days: xp=${k.xp} dniNauki=${k.dniNauki} rekordSerii=${k.rekordSerii} powtorki=${k.powtorki} odznaki=${k.odznaki.keys}")
+    }
+
+    @Test
+    fun `S5 alternatywa w wierszu wbudowanym`() {
+        log("=== S5 built-in row: add a one-letter accepted alternative, keep id?")
+        val repo = Repository(katalog.root)
+        val set = repo.load().sets.first { it.builtIn }
+        val e0 = set.entries.first()
+        val edytowany = set.copy(entries = set.entries.map { Entry(it.term, it.definition + ", a") })
+        repo.upsertSet(edytowany)
+        val po = repo.load().sets.first { it.id == set.id }.entries.first()
+        log("before=$e0 after=$po idKept=${po.id == e0.id}")
+    }
+
+    @Test
+    fun `S6 cel obnizony i zerowe zaliczenie`() {
+        log("=== S6 own capped credit (0 XP) after lowering the goal counts the day")
+        val repo = Repository(katalog.root)
+        repo.load()
+        repo.setOptions(Options(celDnia = 60))
+        val d = 20_000
+        repo.upsertSet(WordSet(id = "user-1", title = "x", entries = (0 until 12).map { Entry("a$it", "a$it") }))
+        val wl = repo.load().sets.first { it.id == "user-1" }.entries.map { it.id }
+        for (id in wl.take(10)) repo.recordAttempt(typed(id), ms(d))
+        log("after 10 own: xpDzis=${repo.load().dorobek.xpDzis} dniNauki=${repo.load().dorobek.dniNauki}")
+        repo.setOptions(Options(celDnia = 30))
+        val w = ArrayList<Wplyw>()
+        repo.recordAttempt(typed(wl[10]), ms(d), naWplyw = { w += it })
+        log("11th own after lowering goal: wplyw=$w dniNauki=${repo.load().dorobek.dniNauki}")
+    }
+
+    @Test
+    fun `S7 zegar tam i z powrotem`() {
+        log("=== S7 clock toggled D, D+1, D, D+1 ... with 3 new words each time")
+        val repo = Repository(katalog.root)
+        val d = 20_000
+        var i = 0
+        repeat(3) { repo.recordAttempt(typed(slowa[i++]), ms(d)) }
+        repeat(30) {
+            repeat(3) { repo.recordAttempt(typed(slowa[i++]), ms(d + 1)) }
+            repo.recordAttempt(typed(slowa[i++]), ms(d))
+        }
+        val k = repo.load().dorobek
+        log("31 toggles in one sitting: dniNauki=${k.dniNauki} seria=${k.seria} rekord=${k.rekordSerii} wolne=${k.wolne} odznaki=${k.odznaki.keys}")
+    }
+}

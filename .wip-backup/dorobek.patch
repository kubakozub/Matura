+package com.matura.app
+
+import com.matura.app.data.BuiltInSets
+import com.matura.app.data.Repository
+import com.matura.app.learn.Attempt
+import com.matura.app.learn.Nagrody
+import com.matura.app.learn.Odznaki
+import com.matura.app.learn.Outcome
+import com.matura.app.learn.Srs
+import com.matura.app.learn.Wplyw
+import com.matura.app.model.Direction
+import com.matura.app.model.Entry
+import com.matura.app.model.GameMode
+import com.matura.app.model.ScoreRecord
+import com.matura.app.model.TaskKind
+import com.matura.app.model.WordSet
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+class ZzSonda1Test {
+
+    @get:Rule
+    val katalog = TemporaryFolder()
+
+    private val out = File("/tmp/claude-0/-home-user-Matura/0e5748ef-99b0-59e1-b03e-46ac0f545d18/scratchpad/sonda-out.txt")
+
+    private fun log(s: String) {
+        out.appendText(s + "\n")
+    }
+
+    private fun poludnie(dzien: Int) = dzien.toLong() * Srs.MS_PER_DAY + 12 * 3_600_000L
+
+    private fun typed(id: String, dir: Direction = Direction.TERM_TO_DEF, outcome: Outcome = Outcome.POPRAWNA, tag: String) =
+        Attempt(id, dir, TaskKind.PRZYPOMNIENIE, outcome, tag)
+
+    @Test
+    fun `P1 przepisany zestaw wbudowany`() {
+        log("=== P1 rewrite built-in sets in place")
+        val repo = Repository(katalog.root)
+        val start = repo.load()
+        val wbudowane = start.sets.filter { it.builtIn }
+        log("built-in sets in save: ${wbudowane.size}")
+        // The editor rebuilds rows from scratch (no ids), keeps set id and builtIn flag.
+        var przepisane = 0
+        for (set in wbudowane.take(12)) {
+            val edytowany = set.copy(entries = set.entries.mapIndexed { i, _ -> Entry("a$i", "a$i") })
+            check(repo.upsertSet(edytowany))
+            przepisane++
+        }
+        val po = repo.load()
+        val pierwszy = po.sets.first { it.id == wbudowane[0].id }
+        log("first set after edit: ${pierwszy.entries.take(3)} ; ids kept = ${pierwszy.entries.map { it.id } == wbudowane[0].entries.map { it.id }}")
+        val wplywy = ArrayList<Wplyw>()
+        val dzien = 20_000
+        var n = 0
+        val widziane = HashSet<String>()
+        for (set in po.sets.filter { it.builtIn }.take(12)) {
+            for (e in set.entries) {
+                if (!widziane.add(e.id)) continue
+                repo.recordAttempt(typed(e.id, tag = "t$n"), poludnie(dzien), naWplyw = { wplywy += it })
+                n++
+            }
+        }
+        val k = repo.load().dorobek
+        log("attempts=$n xp=${k.xp} xpDzis=${k.xpDzis} wlasneDzis=${k.wlasneDzis} limits=${wplywy.mapNotNull { it.limit }.toSet()} etap=${Nagrody.etap(k.xp)} odznaki=${k.odznaki.keys}")
+        // next day and day+4: full climb on trivial content
+        var m = 0
+        for (set in po.sets.filter { it.builtIn }.take(12)) for (e in set.entries) {
+            repo.recordAttempt(typed(e.id, tag = "u${m++}"), poludnie(dzien + 1))
+        }
+        for (set in po.sets.filter { it.builtIn }.take(12)) for (e in set.entries) {
+            repo.recordAttempt(typed(e.id, tag = "v${m++}"), poludnie(dzien + 4))
+        }
+        val k2 = repo.load().dorobek
+        log("after day+4: xp=${k2.xp} etap=${Nagrody.etap(k2.xp)} odznaki=${k2.odznaki.keys}")
+        val l = Odznaki.liczniki(repo.load(), BuiltInSets.all())
+        log("liczniki: poznane=${l.poznane} utrwalone=${l.utrwalone} zestawy=${l.zestawy} dzialy=${l.dzialy}")
+    }
+
+    @Test
+    fun `P1b wlasny zestaw dla porownania`() {
+        log("=== P1b own set comparison (same trivial words as own set)")
+        val repo = Repository(katalog.root)
+        repo.load()
+        check(repo.upsertSet(WordSet(id = "user-1", title = "Moje", entries = (0 until 25).map { Entry("a$it", "a$it") })))
+        val idy = repo.load().sets.first { it.id == "user-1" }.entries.map { it.id }
+        val wplywy = ArrayList<Wplyw>()
+        idy.forEachIndexed { i, id -> repo.recordAttempt(typed(id, tag = "t$i"), poludnie(20_000), naWplyw = { wplywy += it }) }
+        val k = repo.load().dorobek
+        log("own set: xp=${k.xp} limits=${wplywy.mapNotNull { it.limit }.toSet()} odznaki=${k.odznaki.keys}")
+    }
+
+    @Test
+    fun `P2 celowa pomylka codziennie`() {
+        log("=== P2 deliberate daily mistake farm vs honest box-3 reviews")
+        val slowa = BuiltInSets.all().first().entries.map { it.id }.distinct().take(6)
+        // honest
+        run {
+            val dir = File(katalog.root, "honest").also { it.mkdirs() }
+            val repo = Repository(dir)
+            var t = 0
+            val d0 = 20_000
+            for (id in slowa) repo.recordAttempt(typed(id, tag = "h${t++}"), poludnie(d0))
+            for (id in slowa) repo.recordAttempt(typed(id, tag = "h${t++}"), poludnie(d0 + 1))
+            for (id in slowa) repo.recordAttempt(typed(id, tag = "h${t++}"), poludnie(d0 + 4))
+            val baza = repo.load().dorobek
+            for (dz in d0 + 5..d0 + 34) for (id in slowa) repo.recordAttempt(typed(id, tag = "h${t++}"), poludnie(dz))
+            val k = repo.load().dorobek
+            log("honest 30 days, 6 consolidated words answered every day: xp +${k.xp - baza.xp}, powtorki +${k.powtorki - baza.powtorki}, dniNauki +${k.dniNauki - baza.dniNauki}, rekordSerii=${k.rekordSerii}")
+        }
+        run {
+            val dir = File(katalog.root, "farm").also { it.mkdirs() }
+            val repo = Repository(dir)
+            var t = 0
+            val d0 = 20_000
+            for (id in slowa) repo.recordAttempt(typed(id, tag = "f${t++}"), poludnie(d0))
+            for (id in slowa) repo.recordAttempt(typed(id, tag = "f${t++}"), poludnie(d0 + 1))
+            for (id in slowa) repo.recordAttempt(typed(id, tag = "f${t++}"), poludnie(d0 + 4))
+            val baza = repo.load().dorobek
+            // from day d0+4: after each correct answer, one deliberate wrong answer
+            for (id in slowa) repo.recordAttempt(typed(id, outcome = Outcome.BLEDNA, tag = "f${t++}"), poludnie(d0 + 4))
+            for (dz in d0 + 5..d0 + 34) {
+                for (id in slowa) repo.recordAttempt(typed(id, tag = "f${t++}"), poludnie(dz))
+                for (id in slowa) repo.recordAttempt(typed(id, outcome = Outcome.BLEDNA, tag = "f${t++}"), poludnie(dz))
+            }
+            val k = repo.load().dorobek
+            log("farm 30 days, same 6 words, right then deliberately wrong each day: xp +${k.xp - baza.xp}, powtorki +${k.powtorki - baza.powtorki}, dniNauki +${k.dniNauki - baza.dniNauki}, rekordSerii=${k.rekordSerii}, odznaki=${k.odznaki.keys}")
+        }
+    }
+
+    @Test
+    fun `P3 fikstura dwa wczytania`() {
+        log("=== P3 fixture 0.9.4: load, save, reload")
+        val tekst = javaClass.classLoader!!.getResource("zapis-0.9.4-vc21.json")!!.readText()
+        File(katalog.root, Repository.FILE_NAME).writeText(tekst)
+        val a = Repository(katalog.root).load()
+        val b = Repository(katalog.root).load()
+        log("two cold loads equal: ${a == b}; schema=${a.schemaVersion}; xp=${a.dorobek.xp}; odznaki=${a.dorobek.odznaki}")
+        val repo = Repository(katalog.root)
+        val c = repo.load()
+        check(repo.setOptions(c.options))
+        val d = Repository(katalog.root).load()
+        log("after first save reload equal: ${c == d}")
+        val wynik = ScoreRecord("x", "y", 10, 1, 1, 1, 1L, GameMode.CLASSIC)
+        check(Repository(katalog.root).recordGame(wynik, "nope", nowMs = poludnie(20_000)))
+        val e = Repository(katalog.root).load()
+        log("after game: odznakiNowe=${e.dorobek.odznakiNowe} odznaki=${e.dorobek.odznaki}")
+    }
+}

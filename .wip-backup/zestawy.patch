+    fun zapiszKopieZestawu(
+        kopia: WordSet,
+        random: kotlin.random.Random = kotlin.random.Random.Default,
+    ): Boolean = update { d ->
+        val pochodzenie = LinkedHashMap<String, String>()
+        val wydane = HashSet<String>()
+        val wpisy = kopia.entries.map { e ->
+            var nowy = EntryId.newUserId(random)
+            while (!wydane.add(nowy)) nowy = EntryId.newUserId(random)
+            if (e.id.isNotBlank()) pochodzenie[nowy] = e.id
+            e.copy(id = nowy)
+        }
+        val zKopia = zZapisanymZestawem(d, kopia.copy(builtIn = false, entries = wpisy))
+        zKopia.copy(progress = zeSkopiowanymPostepem(zKopia.progress, pochodzenie))
+    }

+package com.matura.app.data
+
+import android.util.Log
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+
+/**
+ * Jeden wiersz szkicu, tak jak stoi w edytorze: takze pusty albo wypelniony w polowie.
+ *
+ * [id] to identyfikator wpisu, z ktorego wiersz powstal, a pusty dla wiersza dopisanego w
+ * edytorze. Bez niego przywrocony szkic bylby dla zapisu lista nowych slow i gubil nauke
+ * zestawu, ktory uczen tylko poprawial.
+ */
+@Serializable
+data class WierszSzkicu(
+    val haslo: String = "",
+    val tlumaczenie: String = "",
+    val id: String = "",
+)
+
+/**
+ * Niezapisana tresc edytora zestawow.
+ *
+ * [idZestawu] to zestaw, z ktorym edytor zostal OTWARTY: null dla nowego zestawu, identyfikator
+ * zestawu wlasnego przy poprawkach, a przy kopii zestawu z katalogu identyfikator oryginalu
+ * (kopia nie ma jeszcze wlasnego, dopoki nie zostanie zapisana).
+ */
+@Serializable
+data class SzkicZestawu(
+    val idZestawu: String? = null,
+    val tytul: String = "",
+    val jezykHasel: String = "",
+    val jezykTlumaczen: String = "",
+    val wiersze: List<WierszSzkicu> = emptyList(),
+) {
+    /**
+     * Tresc w postaci, w jakiej trafilaby do zapisu: bez spacji na brzegach i bez wierszy
+     * calkiem pustych, a identyfikatory wierszy nie graja roli. Dwa szkice o tej samej tresci
+     * znacza dla ucznia to samo, wiec to te postac porownuje edytor, kiedy pyta "czy cos sie
+     * zmienilo". Wiersz wypelniony w polowie ZOSTAJE: to tez jest wpisana praca.
+     */
+    fun tresc(): SzkicZestawu = copy(
+        tytul = tytul.trim(),
+        jezykHasel = jezykHasel.trim(),
+        jezykTlumaczen = jezykTlumaczen.trim(),
+        wiersze = wiersze
+            .map { WierszSzkicu(it.haslo.trim(), it.tlumaczenie.trim()) }
+            .filter { it.haslo.isNotEmpty() || it.tlumaczenie.isNotEmpty() },
+    )
+}
+
+/** Uklad pliku szkicow. Osobna klasa, zeby w pliku lezal obiekt, a nie gola lista. */
+@Serializable
+private data class PlikSzkicow(val szkice: List<SzkicZestawu> = emptyList())
+
+/**
+ * Szkice edytora zestawow na dysku, w pliku [FILE_NAME] obok zapisu gry.
+ *
+ * Po co: stos ekranow zyje tylko w pamieci, wiec gdy uczen w polowie wpisywania zestawu
+ * przejdzie do slownika, a system ubije gre, aplikacja wstaje na ekranie startowym i wpisane
+ * wiersze znikaja. Szkic lezy na dysku i edytor proponuje go przy nastepnym otwarciu.
+ *
+ * Osobny plik, a nie pole w zapisie gry, z dwoch powodow. Edytor pisze szkic mniej wiecej co
+ * sekunde pisania, a zapis gry to caly dokument z katalogiem slow (ponad 150 kB z fsync). I
+ * uszkodzony szkic nie moze pociagnac za soba postepu nauki: tutaj nieczytelny plik po prostu
+ * sie kasuje.
+ *
+ * Plik trzyma najwyzej JEDEN szkic na zestaw (kluczem jest [SzkicZestawu.idZestawu]), a nie
+ * jeden w ogole. Przy jednym szkicu poprawka literowki w innym zestawie nadpisywalaby po
+ * cichu niedokonczony nowy zestaw, ktory czeka na przywrocenie.
+ */
+class SzkiceZestawow(private val dir: File) {
+
+    private val plik = File(dir, FILE_NAME)
+
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    /** Zapisuje szkic w miejsce poprzedniego dla tego samego zestawu. @return czy trafil na dysk. */
+    @Synchronized
+    fun zapisz(szkic: SzkicZestawu): Boolean =
+        zapiszWszystkie(wczytajWszystkie().filterNot { it.idZestawu == szkic.idZestawu } + szkic)
+
+    /** Szkic dla zestawu o tym identyfikatorze (null to nowy zestaw) albo null, gdy go nie ma. */
+    @Synchronized
+    fun wczytaj(idZestawu: String?): SzkicZestawu? =
+        wczytajWszystkie().firstOrNull { it.idZestawu == idZestawu }
+
+    /** Kasuje szkic tego zestawu; szkice innych zestawow zostaja. @return czy plik jest juz bez niego. */
+    @Synchronized
+    fun usun(idZestawu: String?): Boolean {
+        val wszystkie = wczytajWszystkie()
+        if (wszystkie.none { it.idZestawu == idZestawu }) return true
+        return zapiszWszystkie(wszystkie.filterNot { it.idZestawu == idZestawu })
+    }
+
+    /** Dla listy zestawow: przy ktorych zestawach czeka szkic. null w zbiorze to szkic NOWEGO zestawu. */
+    @Synchronized
+    fun zestawyZeSzkicem(): Set<String?> = wczytajWszystkie().map { it.idZestawu }.toSet()
+
+    private fun wczytajWszystkie(): List<SzkicZestawu> {
+        if (!plik.exists()) return emptyList()
+        return try {
+            json.decodeFromString(PlikSzkicow.serializer(), plik.readText()).szkice
+        } catch (e: Exception) {
+            // Inaczej niz przy zapisie gry: tu nie ma czego odkladac na bok. Nieczytelny szkic
+            // wracalby przy kazdym otwarciu edytora jako ten sam blad, wiec znika.
+            Log.w(TAG, "$FILE_NAME nie do odczytania, kasuje: ${e.javaClass.simpleName}: ${e.message}")
+            plik.delete()
+            emptyList()
+        }
+    }
+
+    /** Ten sam zapis dwustopniowy co w [Repository]: caly plik tymczasowy, potem zmiana nazwy. */
+    private fun zapiszWszystkie(szkice: List<SzkicZestawu>): Boolean {
+        if (szkice.isEmpty()) return !plik.exists() || plik.delete()
+        val tmp = File(dir, TEMP_NAME)
+        return try {
+            val tekst = json.encodeToString(PlikSzkicow.serializer(), PlikSzkicow(szkice))
+            FileOutputStream(tmp).use { out ->
+                out.write(tekst.toByteArray(Charsets.UTF_8))
+                out.flush()
+                out.fd.sync()
+            }
+            if (!tmp.renameTo(plik)) throw IOException("zmiana nazwy $TEMP_NAME -> $FILE_NAME nie powiodla sie")
+            true
+        } catch (e: Exception) {
+            Log.w(TAG, "nie udalo sie zapisac $FILE_NAME: ${e.javaClass.simpleName}: ${e.message}")
+            false
+        } finally {
+            if (tmp.exists()) tmp.delete()
+        }
+    }
+
+    companion object {
+        private const val TAG = "MaturaSzkic"
+
+        const val FILE_NAME = "szkic-zestawu.json"
+        const val TEMP_NAME = FILE_NAME + ".tmp"
+    }
+}

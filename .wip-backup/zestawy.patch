+/** Najmniejszy cel dotyku z wytycznych dostepnosci (Material, WCAG 2.5.5). */
+private val NAJMNIEJSZY_CEL = 48.dp
+
+/**
+ * Klikalny cel o wysokosci co najmniej [NAJMNIEJSZY_CEL] wokol grafiki, ktora zostaje taka,
+ * jaka byla.
+ *
+ * Przycisk "Wroc" mial 37 dp wysokosci, a [GhostButton] 47 dp (zmierzone bramka
+ * TouchTargetAuditTest), i bramka trzymala dla nich limit zamiast progu. Zwykle
+ * `defaultMinSize` powiekszyloby ramke przycisku i zepchnelo w dol wszystko pod nia, na
+ * kazdym ekranie. Tutaj rosnie tylko prostokat, w ktory trafia palec i ktory widzi czytnik
+ * ekranu: grafika stoi w jego srodku, a rodzic dostaje do ukladu wysokosc samej grafiki, wiec
+ * cel wystaje po rowno nad nia i pod nia, a uklad zostaje co do piksela ten sam.
+ */
+@Composable
+private fun CelDotyku(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    grafika: @Composable () -> Unit,
+) {
+    Layout(
+        content = grafika,
+        modifier = modifier
+            .layout { measurable, constraints ->
+                val prog = NAJMNIEJSZY_CEL.roundToPx()
+                    .coerceIn(constraints.minHeight, constraints.maxHeight)
+                val cel = measurable.measure(constraints.copy(minHeight = prog))
+                // Wysokosc samej grafiki: wezel w srodku liczy ja, gdy nikt nie narzuca mu minimum.
+                val grafikaPx = measurable.minIntrinsicHeight(cel.width)
+                val zglaszana = constraints.constrainHeight(minOf(grafikaPx, cel.height))
+                layout(cel.width, zglaszana) { cel.place(0, (zglaszana - cel.height) / 2) }
+            }
+            // Klikniecie stoi PO zmianie ukladu, wiec obejmuje caly cel, a nie zgloszona wysokosc.
+            .clickable { onClick() },
+    ) { measurables, constraints ->
+        // Wymuszona szerokosc (fillMaxWidth, weight) idzie do grafiki, minimum wysokosci nie:
+        // inaczej ramka przycisku urosla by razem z celem.
+        val czesci = measurables.map { it.measure(constraints.copy(minHeight = 0)) }
+        val szerokosc = czesci.maxOfOrNull { it.width } ?: constraints.minWidth
+        val wysokosc = maxOf(czesci.maxOfOrNull { it.height } ?: 0, constraints.minHeight)
+        layout(szerokosc, wysokosc) {
+            czesci.forEach { it.place(0, (wysokosc - it.height) / 2) }
+        }
+    }
+}

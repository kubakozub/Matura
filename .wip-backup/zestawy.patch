+    /** @param pochodzenie nowy identyfikator wpisu -> identyfikator, spod ktorego bierzemy stan nauki. */
+    private fun zeSkopiowanymPostepem(
+        progress: Map<String, WordProgress>,
+        pochodzenie: Map<String, String>,
+    ): Map<String, WordProgress> {
+        if (pochodzenie.isEmpty() || progress.isEmpty()) return progress
+        val out = HashMap(progress)
+        for ((nowy, zrodlo) in pochodzenie) {
+            // RANDOM to ustawienie, nie kierunek: Srs.key by go odrzucil.
+            for (kierunek in listOf(Direction.TERM_TO_DEF, Direction.DEF_TO_TERM)) {
+                val stan = progress[Srs.key(zrodlo, kierunek)] ?: continue
+                out[Srs.key(nowy, kierunek)] = stan
+            }
+        }
+        return out
+    }

index 0000000..ab878d4
--- /dev/null
+++ b/app/src/test/java/com/matura/app/ManifestTest.kt
@@ -0,0 +1,97 @@
+package com.matura.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.w3c.dom.Element
+import java.io.File
+import java.util.Properties
+import javax.xml.parsers.DocumentBuilderFactory
+
+/**
+ * Wpisy manifestu, ktorych brak NIE wywraca ani kompilacji, ani zadnego ekranu, tylko po cichu
+ * zabiera cos uczniowi na czesci telefonow.
+ *
+ * Czytamy manifest SCALONY, czyli ten, ktory wchodzi do paczki (sciezke podaje wtyczka Androida
+ * w test_config.properties, tak samo znajduje go Robolectric), a nie plik zrodlowy: biblioteki
+ * dopisuja do manifestu wlasne wpisy i tylko wynik scalenia mowi, co dostaje telefon.
+ *
+ * Czego ten test NIE widzi: funkcji sprzetowych, ktore narzedzia sklepu DOPOWIADAJA sobie same
+ * (uses-implied-feature). To pokazuje dopiero `aapt2 dump badging` na zbudowanej paczce. Tutaj
+ * pilnujemy wpisow, ktore to dopowiadanie wylaczaja.
+ */
+class ManifestTest {
+
+    private companion object {
+        const val ANDROID = "http://schemas.android.com/apk/res/android"
+        const val KONFIGURACJA = "com/android/tools/test_config.properties"
+    }
+
+    private val manifest: Element by lazy {
+        val wlasciwosci = Properties()
+        val strumien = javaClass.classLoader?.getResourceAsStream(KONFIGURACJA)
+        assertNotNull("brak $KONFIGURACJA: wtyczka Androida nie podala sciezki manifestu", strumien)
+        strumien!!.use { wlasciwosci.load(it) }
+        val plik = File(wlasciwosci.getProperty("android_merged_manifest"))
+        assertTrue("nie ma scalonego manifestu: ${plik.absolutePath}", plik.isFile)
+        DocumentBuilderFactory.newInstance()
+            .apply { isNamespaceAware = true }
+            .newDocumentBuilder()
+            .parse(plik)
+            .documentElement
+    }
+
+    private fun Element.dzieci(nazwa: String): List<Element> {
+        val wezly = childNodes
+        return (0 until wezly.length).map { wezly.item(it) }
+            .filterIsInstance<Element>()
+            .filter { it.tagName == nazwa }
+    }
+
+    private fun Element.atrybut(nazwa: String): String = getAttributeNS(ANDROID, nazwa)
+
+    private fun akcjeWidoczneDlaAplikacji(): List<String> =
+        manifest.dzieci("queries")
+            .flatMap { it.dzieci("intent") }
+            .flatMap { it.dzieci("action") }
+            .map { it.atrybut("name") }
+
+    /** "true", "false" albo null, gdy wpisu nie ma wcale. */
+    private fun wymaganaFunkcja(nazwa: String): String? =
+        manifest.dzieci("uses-feature").firstOrNull { it.atrybut("name") == nazwa }?.atrybut("required")
+
+    @Test
+    fun `system pokazuje aplikacji silnik, ktory czyta na glos wlasne zestawy`() {
+        // Nagrania sa tylko dla hasel wbudowanych; slowa z wlasnych zestawow czyta TextToSpeech.
+        // Bez tego wpisu Android 11+ moze ukryc silnik przed aplikacja i glosnik milczy bez bledu.
+        assertTrue(
+            "w <queries> nie ma android.intent.action.TTS_SERVICE",
+            "android.intent.action.TTS_SERVICE" in akcjeWidoczneDlaAplikacji(),
+        )
+    }
+
+    @Test
+    fun `system pokazuje aplikacji rozpoznawanie mowy`() {
+        val akcje = akcjeWidoczneDlaAplikacji()
+        assertTrue("android.speech.RecognitionService" in akcje)
+        assertTrue("android.speech.action.RECOGNIZE_SPEECH" in akcje)
+    }
+
+    @Test
+    fun `mikrofon i ekran pionowy nie sa sprzetem wymaganym`() {
+        // Brak wpisu znaczy tu "wymagane": sklep sam dopowiada mikrofon z uprawnienia
+        // RECORD_AUDIO, a pion z android:screenOrientation, i ukrywa aplikacje przed
+        // urzadzeniami, ktore ich nie zglaszaja.
+        for (funkcja in listOf("android.hardware.microphone", "android.hardware.screen.portrait")) {
+            assertEquals("$funkcja ma byc zadeklarowane jako opcjonalne", "false", wymaganaFunkcja(funkcja))
+        }
+    }
+
+    @Test
+    fun `aplikacja jest zgloszona jako gra`() {
+        // Od Androida 16 tylko gra zachowuje blokade pionu na ekranach od 600 dp.
+        val aplikacja = manifest.dzieci("application").single()
+        assertEquals("game", aplikacja.atrybut("appCategory"))
+    }
+}
diff --git a/app/src/test/java/com/matura/app/PrzerwanyZapisTest.kt b/app/src/test/java/com/matura/app/PrzerwanyZapisTest.kt
new file mode 100644
index 0000000..d41f8e7
--- /dev/null
+++ b/app/src/test/java/com/matura/app/PrzerwanyZapisTest.kt
@@ -0,0 +1,154 @@
+package com.matura.app
+
+import com.matura.app.data.Repository
+import com.matura.app.data.SampleData
+import com.matura.app.model.Entry
+import com.matura.app.model.Profile
+import com.matura.app.model.SaveData
+import com.matura.app.model.WordSet
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+
+/**
+ * STAN DYSKU PO UBICIU APLIKACJI W SRODKU ZAPISU.
+ *
+ * Zapis ma trzy kroki (Repository.writeAtomically):
+ *
+ *     1. cala tresc do matura.json.tmp, z fsync
+ *     2. matura.json      -> matura.json.bak
+ *     3. matura.json.tmp  -> matura.json
+ *
+ * Miedzy krokiem 2 a 3 pliku glownego NIE MA. System potrafi ubic aplikacje dokladnie tam
+ * (brak pamieci, wyjeta bateria) i wtedy na dysku lezy kopia z POPRZEDNIM stanem oraz kompletny
+ * plik tymczasowy z NAJNOWSZYM. Odczyt znal tylko kopie, wiec ostatnia odpowiedz ucznia albo
+ * zapisany przed chwila zestaw przepadaly, choc lezaly w calosci obok.
+ *
+ * Kazdy test uklada pliki recznie, w tej kolejnosci, w jakiej zostawia je przerwany zapis:
+ * samym Repository tego stanu nie da sie wywolac, bo po kazdym zapisie sprzata ono plik
+ * tymczasowy.
+ */
+class PrzerwanyZapisTest {
+
+    @get:Rule
+    val katalog = TemporaryFolder()
+
+    /** Drugi katalog, w ktorym powstaje tresc "nastepnego zapisu"; badany zostaje czysty. */
+    @get:Rule
+    val obok = TemporaryFolder()
+
+    private fun plik(nazwa: String) = File(katalog.root, nazwa)
+
+    private fun stan(imie: String) = SaveData(
+        schemaVersion = Repository.SCHEMA_VERSION,
+        profile = Profile(name = imie),
+        sets = SampleData.builtInSets() + WordSet(
+            id = "user-1",
+            title = "Moje słówka",
+            entries = listOf(Entry("dog", "pies"), Entry(imie, "ostatnio dopisane")),
+        ),
+    )
+
+    /** Tresc dokladnie taka, jaka Repository kladzie na dysk: zapisana nim samym, w innym katalogu. */
+    private fun trescPliku(dane: SaveData): String {
+        val osobny = obok.newFolder()
+        assertTrue(Repository(osobny).save(dane))
+        return File(osobny, Repository.FILE_NAME).readText()
+    }
+
+    /**
+     * Dwa pelne zapisy, a trzeci ubity miedzy zmianami nazw: kopia ma stan drugiego zapisu,
+     * plik tymczasowy caly stan trzeciego, pliku glownego nie ma.
+     */
+    private fun ubityMiedzyZmianamiNazw(trescTymczasowego: String = trescPliku(stan("trzeci"))) {
+        val repo = Repository(katalog.root)
+        assertTrue(repo.save(stan("pierwszy")))
+        assertTrue(repo.save(stan("drugi")))
+
+        plik(Repository.TEMP_NAME).writeText(trescTymczasowego)                         // krok 1
+        assertTrue(plik(Repository.FILE_NAME).renameTo(plik(Repository.BACKUP_NAME)))   // krok 2
+        // kroku 3 juz nie bylo
+    }
+
+    private fun naDysku(): Map<String, String> =
+        katalog.root.listFiles()!!.associate { it.name to it.readText() }
+
+    @Test
+    fun `zapis ubity miedzy zmianami nazw oddaje najnowszy stan, nie poprzedni`() {
+        ubityMiedzyZmianamiNazw()
+        assertFalse("to nie jest stan, o ktory chodzi w tescie", plik(Repository.FILE_NAME).exists())
+
+        val odczytane = Repository(katalog.root).load()
+
+        assertEquals("trzeci", odczytane.profile.name)
+        assertEquals(
+            "zestaw wlasny wrocil w starszej wersji",
+            listOf("dog", "trzeci"),
+            odczytane.sets.single { it.id == "user-1" }.entries.map { it.term },
+        )
+    }
+
+    @Test
+    fun `odczyt po przerwanym zapisie niczego na dysku nie rusza`() {
+        ubityMiedzyZmianamiNazw()
+        val przed = naDysku()
+        assertEquals(setOf(Repository.BACKUP_NAME, Repository.TEMP_NAME), przed.keys)
+
+        Repository(katalog.root).load()
+
+        // load() nie pisze: gdyby tu sprzatal albo przenosil pliki, kolejne ubicie w zlym
+        // momencie zostawialoby stan, ktorego nikt nie przewidzial.
+        assertEquals(przed, naDysku())
+    }
+
+    @Test
+    fun `pierwszy zapis po odzyskaniu odtwarza plik glowny`() {
+        ubityMiedzyZmianamiNazw()
+        val repo = Repository(katalog.root)
+        repo.load()
+
+        assertTrue(repo.save(stan("czwarty")))
+
+        assertEquals("czwarty", Repository(katalog.root).load().profile.name)
+        assertTrue(plik(Repository.FILE_NAME).exists())
+        assertFalse("plik tymczasowy przezyl zapis", plik(Repository.TEMP_NAME).exists())
+    }
+
+    @Test
+    fun `urwany plik tymczasowy nie wygrywa z cala kopia`() {
+        // Tak wyglada ubicie w kroku 1 przy brakujacym pliku glownym: ogon JSON-a nie doszedl.
+        val caly = trescPliku(stan("trzeci"))
+        ubityMiedzyZmianamiNazw(trescTymczasowego = caly.take(caly.length / 2))
+
+        val odczytane = Repository(katalog.root).load()
+
+        assertEquals("drugi", odczytane.profile.name)
+        assertTrue("urwanego pliku tez nie kasujemy przy odczycie", plik(Repository.TEMP_NAME).exists())
+    }
+
+    @Test
+    fun `caly plik glowny dalej ma pierwszenstwo przed tymczasowym`() {
+        // Ubicie PRZED krokiem 2: plik glowny jest na miejscu i to on jest ostatnim stanem,
+        // ktory zapis zdazyl potwierdzic. Kolejnosc odczytu zmienia sie tylko tam, gdzie
+        // pliku glownego nie ma.
+        val repo = Repository(katalog.root)
+        assertTrue(repo.save(stan("pierwszy")))
+        assertTrue(repo.save(stan("drugi")))
+        plik(Repository.TEMP_NAME).writeText(trescPliku(stan("trzeci")))
+
+        assertEquals("drugi", Repository(katalog.root).load().profile.name)
+    }
+
+    @Test
+    fun `pierwszy zapis w zyciu ubity przed zmiana nazwy tez sie odzyskuje`() {
+        // Swiezo zainstalowana aplikacja: nie ma ani pliku glownego, ani kopii, wiec krok 2
+        // nie ma czego przenosic, a ubicie przed krokiem 3 zostawia sam plik tymczasowy.
+        plik(Repository.TEMP_NAME).writeText(trescPliku(stan("pierwszy")))
+
+        assertEquals("pierwszy", Repository(katalog.root).load().profile.name)
+    }
+}
diff --git a/app/src/test/java/com/matura/app/StartAktywnosciTest.kt b/app/src/test/java/com/matura/app/StartAktywnosciTest.kt
new file mode 100644
index 0000000..182c808
--- /dev/null
+++ b/app/src/test/java/com/matura/app/StartAktywnosciTest.kt
@@ -0,0 +1,123 @@
+package com.matura.app
+
+import android.content.Context
+import android.content.Intent
+import android.view.ViewGroup
+import androidx.core.view.WindowCompat
+import androidx.test.core.app.ApplicationProvider
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.android.controller.ActivityController
+import org.robolectric.annotation.Config
+
+/**
+ * Co MainActivity robi z oknem i z wlasna instancja, zanim pokaze pierwszy ekran.
+ *
+ * Dwie rzeczy, obie niewidoczne w testach samych ekranow, bo tamte skladaja MaturaApp wprost:
+ *
+ *  1. PASKI SYSTEMOWE. Gra jest zawsze ciemna, a enableEdgeToEdge() bez argumentow dobiera
+ *     ikony do motywu telefonu. Przy jasnym motywie, czyli domyslnym, zegar i bateria wychodzily
+ *     ciemne na prawie czarnym tle.
+ *
+ *  2. DRUGA INSTANCJA Z IKONY. Na Androidzie 7 do 9 start z przycisku "Otworz" w sklepie albo
+ *     instalatorze, a potem z ikony, kladzie druga MainActivity na pierwszej. Kazda ma wlasny
+ *     obraz danych w pamieci, wiec ta odslonieta pozniej pokazuje i zapisuje stary stan.
+ *
+ * DLACZEGO SAMO create(), BEZ setup(). Okno dolaczone do systemu (visible()) uruchamia cala
+ * kompozycje, a ten test nie ma reguly Compose, bo dziala tez w wariancie release. Wszystko,
+ * co tu sprawdzamy, dzieje sie w onCreate, wiec okno nie jest potrzebne.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], qualifiers = "w411dp-h891dp-xxhdpi")
+class StartAktywnosciTest {
+
+    /** Bez tego nastepne testy ekranow w tej samej maszynie wisza: patrz GlownaPetla.kt. */
+    @After
+    fun posprzataj() = wykonajToCoCzekaWGlownejPetli()
+
+    private val aplikacja get() = ApplicationProvider.getApplicationContext<Context>()
+
+    /** Tak startuje ikona na pulpicie i przycisk "Otworz". */
+    private fun intentZIkony() = Intent(Intent.ACTION_MAIN)
+        .addCategory(Intent.CATEGORY_LAUNCHER)
+        .setClass(aplikacja, MainActivity::class.java)
+
+    private fun ActivityController<MainActivity>.liczbaWidokowTresci(): Int =
+        get().findViewById<ViewGroup>(android.R.id.content).childCount
+
+    // --- paski systemowe --------------------------------------------------------------------
+
+    @Test
+    @Config(qualifiers = "+notnight")
+    fun `przy jasnym motywie telefonu ikony paskow zostaja jasne`() {
+        Robolectric.buildActivity(MainActivity::class.java, intentZIkony()).use { kontroler ->
+            kontroler.create()
+            val okno = kontroler.get().window
+            val paski = WindowCompat.getInsetsController(okno, okno.decorView)
+
+            // "Light" w nazwach systemowych znaczy JASNY PASEK, czyli ciemne ikony.
+            assertFalse(
+                "pasek stanu dostal ciemne ikony, a pod nim jest prawie czarne tlo gry",
+                paski.isAppearanceLightStatusBars,
+            )
+            assertFalse(
+                "pasek nawigacji dostal ciemne przyciski na ciemnym tle",
+                paski.isAppearanceLightNavigationBars,
+            )
+            assertFalse(
+                "system doklada wlasna polprzezroczysta nakladke pod przyciski nawigacji",
+                okno.isNavigationBarContrastEnforced,
+            )
+        }
+    }
+
+    // --- druga instancja z ikony ------------------------------------------------------------
+
+    @Test
+    fun `druga instancja z ikony konczy sie, zanim cokolwiek pokaze`() {
+        Robolectric.buildActivity(MainActivity::class.java, intentZIkony()).use { kontroler ->
+            shadowOf(kontroler.get()).setIsTaskRoot(false)
+
+            kontroler.create()
+
+            assertTrue("zbedna instancja zostala na stosie", kontroler.get().isFinishing)
+            assertEquals(
+                "zbedna instancja zdazyla zlozyc ekran, czyli wczytac wlasna kopie danych",
+                0,
+                kontroler.liczbaWidokowTresci(),
+            )
+        }
+    }
+
+    @Test
+    fun `zwykly start z ikony pokazuje gre`() {
+        Robolectric.buildActivity(MainActivity::class.java, intentZIkony()).use { kontroler ->
+            kontroler.create()
+
+            assertFalse(kontroler.get().isFinishing)
+            assertEquals(1, kontroler.liczbaWidokowTresci())
+        }
+    }
+
+    @Test
+    fun `instancja nie z ikony zostaje, nawet gdy nie jest korzeniem zadania`() {
+        // Straznik ma lapac wylacznie podwojny start z ikony. Jawne uruchomienie z innej
+        // aplikacji (bez kategorii LAUNCHER) to czyjas swiadoma decyzja, nie blad systemu.
+        val jawny = Intent(aplikacja, MainActivity::class.java)
+        Robolectric.buildActivity(MainActivity::class.java, jawny).use { kontroler ->
+            shadowOf(kontroler.get()).setIsTaskRoot(false)
+
+            kontroler.create()
+
+            assertFalse(kontroler.get().isFinishing)
+            assertEquals(1, kontroler.liczbaWidokowTresci())
+        }
+    }
+}
diff --git a/app/src/test/java/com/matura/app/ZmianaKonfiguracjiTest.kt b/app/src/test/java/com/matura/app/ZmianaKonfiguracjiTest.kt
new file mode 100644
index 0000000..0886090
--- /dev/null
+++ b/app/src/test/java/com/matura/app/ZmianaKonfiguracjiTest.kt
@@ -0,0 +1,144 @@
+package com.matura.app
+
+import android.app.Activity
+import android.app.Application
+import android.content.pm.ActivityInfo
+import android.content.res.Configuration
+import android.os.Bundle
+import androidx.test.core.app.ApplicationProvider
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertSame
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.util.Locale
+
+/**
+ * ZMIANA USTAWIEN TELEFONU NIE MOZE BUDOWAC EKRANU OD NOWA.
+ *
+ * Caly stan aplikacji poza zapisem (stos ekranow, trwajaca runda, wiersze wpisywanego zestawu)
+ * siedzi w zwyklym remember, wiec zyje dokladnie tak dlugo, jak instancja MainActivity. Kazda
+ * zmiana konfiguracji, ktorej manifest nie deklaruje w android:configChanges, konczy sie nowa
+ * instancja: uczen laduje na ekranie z imieniem, runda znika bez wyniku, a wpisywany zestaw
+ * przepada. Do 0.9.18 manifest deklarowal tylko orientation, screenSize, keyboardHidden
+ * i uiMode, czyli restartem konczyly sie rzeczy zupelnie codzienne: wieksza czcionka,
+ * rozlozenie skladaka, dzielony ekran, wlaczenie klawiatury Bluetooth.
+ *
+ * Test idzie przez ten sam mechanizm co system: ActivityController porownuje zmienione pola
+ * z ActivityInfo.configChanges ze SCALONEGO manifestu i albo wola onConfigurationChanged, albo
+ * buduje nowa instancje. Usuniecie jednej flagi z manifestu wywraca odpowiedni krok.
+ *
+ * Czy ekrany po takiej zmianie dalej dobrze sie rysuja (Compose czyta gestosc na nowo) i czy
+ * wpisany tekst zostaje, sprawdza MainActivityNaEkranieTest: potrzebuje reguly Compose, a ta
+ * jest tylko w wariancie debug.
+ *
+ * Z tego samego powodu ekran jest tu wznowiony, ale jego okno NIE jest dolaczone (brak
+ * visible()): dolaczone okno uruchamia cala kompozycje, a ta bez reguly nie ma kto prowadzic.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], qualifiers = "w411dp-h891dp-xxhdpi")
+class ZmianaKonfiguracjiTest {
+
+    /** Bez tego nastepne testy ekranow w tej samej maszynie wisza: patrz GlownaPetla.kt. */
+    @After
+    fun posprzataj() = wykonajToCoCzekaWGlownejPetli()
+
+    /** Jedno zdarzenie z zycia telefonu: co zmienia w konfiguracji i ktorych flag manifestu wymaga. */
+    private class Zdarzenie(val opis: String, val flagi: Int, val zmiana: Configuration.() -> Unit)
+
+    private val zdarzenia = listOf(
+        Zdarzenie("wieksza czcionka w ustawieniach telefonu", ActivityInfo.CONFIG_FONT_SCALE) {
+            fontScale *= 1.3f
+        },
+        Zdarzenie(
+            "inny rozmiar wyswietlania",
+            ActivityInfo.CONFIG_DENSITY or ActivityInfo.CONFIG_SCREEN_SIZE or
+                ActivityInfo.CONFIG_SMALLEST_SCREEN_SIZE,
+        ) {
+            // Te same piksele, gestsza siatka: ekran ma mniej dp w obu osiach.
+            densityDpi = 540
+            screenWidthDp = 365
+            screenHeightDp = 792
+            smallestScreenWidthDp = 365
+        },
+        Zdarzenie(
+            "rozlozony skladak albo dzielony ekran",
+            ActivityInfo.CONFIG_SCREEN_SIZE or ActivityInfo.CONFIG_SMALLEST_SCREEN_SIZE or
+                ActivityInfo.CONFIG_SCREEN_LAYOUT,
+        ) {
+            screenWidthDp = 700
+            screenHeightDp = 780
+            smallestScreenWidthDp = 700
+            screenLayout = (screenLayout and Configuration.SCREENLAYOUT_SIZE_MASK.inv()) or
+                Configuration.SCREENLAYOUT_SIZE_LARGE
+        },
+        Zdarzenie(
+            "podlaczona klawiatura Bluetooth",
+            ActivityInfo.CONFIG_KEYBOARD or ActivityInfo.CONFIG_KEYBOARD_HIDDEN or
+                ActivityInfo.CONFIG_NAVIGATION,
+        ) {
+            keyboard = Configuration.KEYBOARD_QWERTY
+            keyboardHidden = Configuration.KEYBOARDHIDDEN_NO
+            hardKeyboardHidden = Configuration.HARDKEYBOARDHIDDEN_NO
+            navigation = Configuration.NAVIGATION_DPAD
+        },
+        Zdarzenie(
+            "inny jezyk systemu, pisany od prawej",
+            ActivityInfo.CONFIG_LOCALE or ActivityInfo.CONFIG_LAYOUT_DIRECTION,
+        ) {
+            setLocale(Locale.forLanguageTag("ar-EG"))
+        },
+    )
+
+    private class LicznikInstancji : Application.ActivityLifecycleCallbacks {
+        var utworzone = 0
+        var zniszczone = 0
+        override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) { utworzone++ }
+        override fun onActivityDestroyed(activity: Activity) { zniszczone++ }
+        override fun onActivityStarted(activity: Activity) = Unit
+        override fun onActivityResumed(activity: Activity) = Unit
+        override fun onActivityPaused(activity: Activity) = Unit
+        override fun onActivityStopped(activity: Activity) = Unit
+        override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) = Unit
+    }
+
+    @Test
+    fun `zmiany ustawien telefonu trafiaja do tej samej instancji ekranu`() {
+        val licznik = LicznikInstancji()
+        ApplicationProvider.getApplicationContext<Application>()
+            .registerActivityLifecycleCallbacks(licznik)
+
+        Robolectric.buildActivity(MainActivity::class.java).use { kontroler ->
+            kontroler.create().start().resume()
+            val ekran = kontroler.get()
+
+            for (z in zdarzenia) {
+                val przed = Configuration(ekran.resources.configuration)
+                val po = Configuration(przed).apply(z.zmiana)
+                // Kontrola samego testu: gdyby "zmiana" niczego nie zmieniala, kontroler po
+                // prostu zawolalby onConfigurationChanged i test przeszedlby przy kazdym manifescie.
+                assertEquals(
+                    "${z.opis}: konfiguracja testowa nie rusza pol, o ktore chodzi",
+                    z.flagi,
+                    przed.diff(po) and z.flagi,
+                )
+
+                kontroler.configurationChange(po)
+
+                assertSame(
+                    "${z.opis}: system zbudowal MainActivity od nowa, a z nia zniknal caly " +
+                        "stan trzymany w remember (runda, wpisywany zestaw, stos ekranow)",
+                    ekran,
+                    kontroler.get(),
+                )
+                assertFalse("${z.opis}: instancja zostala zniszczona", ekran.isDestroyed)
+                assertEquals("${z.opis}: liczba utworzonych instancji", 1, licznik.utworzone)
+                assertEquals("${z.opis}: liczba zniszczonych instancji", 0, licznik.zniszczone)
+            }
+        }
+    }
+}
diff --git a/app/src/testDebug/java/com/matura/app/MainActivityNaEkranieTest.kt b/app/src/testDebug/java/com/matura/app/MainActivityNaEkranieTest.kt

+    /**
+     * Postep idzie za zamiana kolumn w edytorze (przycisk "Zamien strony").
+     *
+     * Klucz postepu to identyfikator wpisu i KIERUNEK, a TERM_TO_DEF znaczy "widze haslo,
+     * podaje tlumaczenie". Zamiana kolumn zostawia wierszowi jego identyfikator, wiec bez tego
+     * kroku oba zapisy opisywaly po zamianie odwrotne umiejetnosci: slowo cwiczone tylko z
+     * angielskiego na polski bylo "utrwalone" w kierunku, ktorego uczen nigdy nie probowal, a
+     * naprawde cwiczony kierunek startowal od zera.
+     *
+     * Regula: wpis, ktory ZACHOWAL identyfikator i ktorego (haslo, tlumaczenie) to poprzednie
+     * (tlumaczenie, haslo), zamienia miejscami swoje dwa zapisy. Wiersz poprawiony przy okazji
+     * zamiany nie spelnia jej i zostaje, jak byl: po tresci nie da sie go odroznic od zwyklej
+     * poprawki.
+     */
+    private fun postepPoZamianieKolumn(
+        progress: Map<String, WordProgress>,
+        poprzednie: List<Entry>,
+        zapisane: List<Entry>,
+    ): Map<String, WordProgress> {
+        if (progress.isEmpty() || poprzednie.isEmpty()) return progress
+        val dawne = poprzednie.filter { it.id.isNotBlank() }.associateBy { it.id }
+        var out: HashMap<String, WordProgress>? = null
+        val przestawione = HashSet<String>()
+        for (e in zapisane) {
+            val byl = dawne[e.id] ?: continue
+            val teraz = EntryId.contentKey(e.term, e.definition)
+            if (teraz != EntryId.contentKey(byl.definition, byl.term)) continue
+            // Wiersz o dwoch jednakowych stronach jest swoim wlasnym odbiciem: nic sie nie zmienilo.
+            if (teraz == EntryId.contentKey(byl.term, byl.definition)) continue
+            if (!przestawione.add(e.id)) continue
+            val kluczHaslo = Srs.key(e.id, Direction.TERM_TO_DEF)
+            val kluczTlumaczenie = Srs.key(e.id, Direction.DEF_TO_TERM)
+            val stanHaslo = progress[kluczHaslo]
+            val stanTlumaczenie = progress[kluczTlumaczenie]
+            if (stanHaslo == null && stanTlumaczenie == null) continue
+            val mapa = out ?: HashMap(progress).also { out = it }
+            // Brak zapisu znaczy "pudelko 0", wiec po zamianie brak tez musi przejsc na druga strone.
+            if (stanTlumaczenie != null) mapa[kluczHaslo] = stanTlumaczenie else mapa.remove(kluczHaslo)
+            if (stanHaslo != null) mapa[kluczTlumaczenie] = stanHaslo else mapa.remove(kluczTlumaczenie)
+        }
+        return out ?: progress
+    }

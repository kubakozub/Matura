+    /**
+     * Wspolny krok [upsertSet] i [zapiszKopieZestawu]: zestaw trafia na liste z uzgodnionymi
+     * identyfikatorami wpisow (nowy na koniec, istniejacy w swoje miejsce).
+     */
+    private fun zZapisanymZestawem(d: SaveData, set: WordSet): SaveData {
+        val idx = d.sets.indexOfFirst { it.id == set.id }
+        val poprzednie = if (idx >= 0) d.sets[idx].entries else emptyList()
+        val zTozsamoscia = set.copy(
+            entries = EntryId.reconcile(poprzednie, set.entries, builtInSet = set.builtIn),
+        )
+        val sets = if (idx >= 0) {
+            d.sets.toMutableList().also { it[idx] = zTozsamoscia }
+        } else {
+            d.sets + zTozsamoscia
+        }
+        // Zestawu wbudowanego to nie dotyczy: jego identyfikatory licza sie z tresci i sa
+        // wspolne z katalogiem, wiec zamiana stron w starym, edytowanym zestawie wbudowanym
+        // nie moze przestawiac postepu slow, ktore katalog dalej pokazuje po staremu.
+        val progress = if (set.builtIn) {
+            d.progress
+        } else {
